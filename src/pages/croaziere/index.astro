---
import Layout from '../../layouts/Layout.astro';
import CruiseCard from '../../components/CruiseCard.astro';
import CommunityBanner from '../../components/CommunityBanner.astro';
import Newsletter from '../../components/Newsletter.astro';
import cruises from '../../../data/cruises.json';
---

<Layout 
  title="Croaziere Ieftine cu Zbor Inclus din România (MSC, Costa)"
  description="Pachete complete de croazieră DIY: zboruri ieftine din București/Cluj către porturile de îmbarcare + 7 nopți pe vas cu pensiune completă inclusă."
>
  <!-- Hero Section -->
  <section class="gradient-hero text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/20 backdrop-blur border border-indigo-400/30 text-xs sm:text-sm font-bold text-indigo-200 mb-6 shadow-md">
        <span>🚢 EXPERIENȚE PE MARE & OCEAN</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight mb-4">
        Croaziere de Lux la <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-indigo-300">prețuri pe cont propriu</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        Nu plăti mii de euro la agenții! Combinăm zborurile low-cost din România direct spre porturile de îmbarcare (Barcelona, Civitavecchia, Pireu, Dubai) cu tarifele oficiale de croazieră cu pensiune completă.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-300">
        <span class="px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur border border-white/10">✓ Pensiune Completă (Gourmet)</span>
        <span class="px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur border border-white/10">✓ 4-5 țări într-o săptămână</span>
        <span class="px-3 py-1.5 rounded-xl bg-white/10 backdrop-blur border border-white/10">✓ Spectacole Broadway incluse</span>
      </div>
    </div>
  </section>

  <!-- Cruises Grid Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Pachete de Croazieră Verificate ({cruises.length})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Prețuri totale calculate per persoană: bilet avion dus-întors din România + cabină dublă pe navă.
        </p>
      </div>

      <span class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-900 text-xs font-bold">
        Oferte Active
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cruises.map(cruise => (
        <CruiseCard cruise={cruise} />
      ))}
    </div>
  </section>

  <!-- Community Banner & Newsletter -->
  <CommunityBanner />
  <Newsletter />
</Layout>
