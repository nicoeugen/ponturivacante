---
import airports from '../../data/airports.json';
---

<section class="gradient-hero text-white pt-5 sm:pt-8 pb-8 sm:pb-12 px-3 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-rose-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <!-- Seasonal Announcement Badges (Compacte pe mobil) -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-3">
      <a 
        href="/categorie/schi/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-sky-400/20 hover:bg-sky-400/30 backdrop-blur border border-sky-300/40 text-xs sm:text-sm font-bold text-sky-200 transition-all hover:scale-105 shadow-md"
      >
        <span>🎿 SEZON SCHI:</span>
        <span class="hidden sm:inline text-white font-normal">Bansko, Dolomiți, Tirol & Jasna &rarr;</span>
        <span class="sm:hidden text-white font-normal">Oferte &rarr;</span>
      </a>
      <a 
        href="/categorie/exotice/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-400/20 hover:bg-amber-400/30 backdrop-blur border border-amber-300/40 text-xs sm:text-sm font-bold text-amber-200 transition-all hover:scale-105 shadow-md"
      >
        <span>🌴 SOARE DE IARNĂ:</span>
        <span class="hidden sm:inline text-white font-normal">Tenerife, Dubai, Canare &rarr;</span>
        <span class="sm:hidden text-white font-normal">Plajă &rarr;</span>
      </a>
    </div>

    <h1 class="text-xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight mb-2 sm:mb-2.5">
      Călătorește pe cont propriu la <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-rose-300 to-rose-400">jumătate de preț</span>
    </h1>

    <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto mb-4 sm:mb-5 leading-relaxed px-2">
      Găsim biletele de avion și cazările la cel mai mic tarif verificat. Tu doar dai click și rezervi direct la sursă, fără comisioane de agenție.
    </p>

    <!-- Interactive Filter & Search Box -->
    <div id="filtre" class="bg-white rounded-3xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.5)] border-2 border-white ring-4 ring-black/10 text-slate-900 text-left max-w-4xl mx-auto p-4 sm:p-6 space-y-4">
      <!-- Transport Mode Selector Tabs -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
        <div class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
          <span>Mod de călătorie:</span>
        </div>
        <div class="grid grid-cols-3 sm:inline-flex p-1 bg-slate-100 border border-slate-200 rounded-xl gap-1 text-xs font-bold text-slate-700 w-full sm:w-auto">
          <button 
            type="button" 
            data-transport="all" 
            class="transport-tab active px-2 sm:px-3.5 py-2 rounded-lg bg-white text-slate-950 shadow-md transition-all cursor-pointer font-black text-center truncate"
          >
            <span>🌟</span> <span class="hidden sm:inline">Toate Ofertele</span><span class="sm:hidden">Toate</span>
          </button>
          <button 
            type="button" 
            data-transport="flight" 
            class="transport-tab px-2 sm:px-3.5 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer font-semibold text-center truncate"
          >
            <span>✈️</span> <span class="hidden sm:inline">Cu Avion Inclus</span><span class="sm:hidden">Avion</span>
          </button>
          <button 
            type="button" 
            data-transport="car" 
            class="transport-tab px-2 sm:px-3.5 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer font-semibold text-center truncate"
          >
            <span>🚗</span> <span class="hidden sm:inline">Pe cont propriu (Mașină)</span><span class="sm:hidden">Mașină</span>
          </button>
        </div>
      </div>

      <!-- Search Input -->
      <div class="relative flex items-center">
        <span class="absolute left-4 pointer-events-none text-rose-600 text-lg sm:text-xl">
          🔍
        </span>
        <input 
          type="text" 
          id="filter-search" 
          placeholder="Caută destinație (ex: Roma, Bansko, Milano, Tenerife, Viena, Napoli...)" 
          class="w-full bg-slate-50 hover:bg-white focus:bg-white border-2 border-slate-300 hover:border-slate-400 focus:border-rose-600 focus:ring-4 focus:ring-rose-500/20 rounded-2xl pl-12 pr-4 py-3 sm:py-3.5 text-sm sm:text-base font-bold text-slate-950 placeholder-slate-400 shadow-inner transition-all"
        />
      </div>

      <!-- Trending Quick Search Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-bold no-scrollbar">
        <span class="text-slate-500 whitespace-nowrap text-[11px] uppercase tracking-wider font-black flex items-center gap-1">
          <span>🔥</span> Rapid:
        </span>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-budget="100">
          💸 Sub 100 €
        </button>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-category="Schi">
          🎿 Schi & Iarnă
        </button>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-query="Tenerife">
          🌴 Tenerife & Canare
        </button>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-query="Roma">
          🏛️ Roma
        </button>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-query="Viena">
          🎄 Târguri Crăciun
        </button>
        <button type="button" class="hero-chip px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-800 transition-all whitespace-nowrap cursor-pointer border border-slate-200 hover:border-rose-600 shadow-sm font-bold text-xs active:scale-95" data-query="Londra">
          🇬🇧 Londra
        </button>
      </div>

      <!-- Dropdown Selectors Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <!-- Filter 1: Oraș Plecare -->
        <div>
          <label id="filter-origin-label" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
            🛫 Oraș de plecare
          </label>
          <select 
            id="filter-origin" 
            class="w-full bg-white border-2 border-slate-300 hover:border-slate-400 focus:border-rose-600 focus:ring-2 focus:ring-rose-500/20 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-sm transition-all cursor-pointer"
          >
            <option value="all">Toate orașele din România</option>
            {airports.map(ap => (
              <option value={ap.city} data-city={ap.city} data-code={ap.code}>{ap.city} ({ap.code})</option>
            ))}
          </select>
        </div>

        <!-- Filter 2: Buget Maxim -->
        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
            💰 Buget maxim / pers.
          </label>
          <select 
            id="filter-budget" 
            class="w-full bg-white border-2 border-slate-300 hover:border-slate-400 focus:border-rose-600 focus:ring-2 focus:ring-rose-500/20 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-sm transition-all cursor-pointer"
          >
            <option value="all">Oricare buget</option>
            <option value="100">Sub 100 € (Chilipir)</option>
            <option value="150">Sub 150 € (City Break)</option>
            <option value="250">Sub 250 € (Soare & Canare)</option>
            <option value="350">Sub 350 € (Sejur & Soare)</option>
            <option value="500">Sub 500 € (Vacanțe & Circuite)</option>
          </select>
        </div>

        <!-- Filter 3: Tip Vacanță -->
        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
            🏖️ Tip vacanță
          </label>
          <select 
            id="filter-category" 
            class="w-full bg-white border-2 border-slate-300 hover:border-slate-400 focus:border-rose-600 focus:ring-2 focus:ring-rose-500/20 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-sm transition-all cursor-pointer"
          >
            <option value="all">Toate tipurile</option>
            <option value="City Break">City Break European</option>
            <option value="Schi">Vacanță la Schi</option>
            <option value="Exotic">Soare & Plajă (Iarnă/Primăvară)</option>
            <option value="Weekend">Escapadă de Weekend</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</section>
