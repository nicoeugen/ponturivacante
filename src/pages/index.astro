---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DealCard from '../components/DealCard.astro';
import CommunityBanner from '../components/CommunityBanner.astro';
import Newsletter from '../components/Newsletter.astro';
import AgodaBanner from '../components/AgodaBanner.astro';
import KiwiBanner from '../components/KiwiBanner.astro';
import deals from '../../data/deals.json';

// Sort deals with newest first
const sortedDeals = [...deals].sort((a, b) => 
  new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const originCounts: Record<string, number> = {};
deals.forEach(d => {
  const city = d.originCity || 'București';
  originCounts[city] = (originCounts[city] || 0) + 1;
});

const topOrigins = Object.entries(originCounts)
  .sort((a, b) => b[1] - a[1]);
---

<Layout title="Ponturi Vacanțe Ieftine din România — Zbor + Cazare">
  <!-- Hero Section with Filter Controls -->
  <Hero />

  <!-- Deals Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-16 relative z-20">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Cele mai noi oferte verificate</span>
          <span id="active-deals-badge" class="text-xs font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">
            {deals.length} oferte active
          </span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Prețuri calculate per persoană: bilet avion dus-întors (sau transport propriu cu mașina) + cazare verificată.
        </p>
      </div>

      <!-- Reset Filter Button (Hidden by default) -->
      <button 
        id="btn-reset-filters" 
        class="hidden text-xs font-bold text-rose-600 hover:text-rose-800 underline cursor-pointer text-left sm:text-right"
      >
        Resetează toate filtrele
      </button>
    </div>

    <!-- Quick Origin City Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-4 mb-2 no-scrollbar">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider whitespace-nowrap mr-1">Plecare:</span>
      <button type="button" class="city-pill active px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-xs font-bold shadow-sm transition-all whitespace-nowrap cursor-pointer hover:bg-rose-600" data-city="all">
        Toate ({deals.length})
      </button>
      {topOrigins.map(([city, count]) => (
        <button type="button" class="city-pill px-3.5 py-1.5 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-bold shadow-sm transition-all whitespace-nowrap cursor-pointer hover:bg-rose-50 hover:text-rose-600 hover:border-rose-300" data-city={city}>
          ✈️ {city} <span class="text-[10px] opacity-70">({count})</span>
        </button>
      ))}
    </div>

    <!-- Deals Grid -->
    <div id="deals-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {sortedDeals.map(deal => (
        <DealCard deal={deal} />
      ))}
    </div>

    <!-- Load More Button -->
    <div id="load-more-container" class="mt-12 text-center">
      <button 
        id="btn-load-more" 
        type="button" 
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-900 border-2 border-slate-200 hover:border-rose-300 hover:text-rose-600 font-extrabold text-sm sm:text-base shadow-sm hover:shadow-md transition-all cursor-pointer group"
      >
        <span id="load-more-text">Afișează încă 12 oferte</span>
        <span class="w-7 h-7 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-xs group-hover:translate-y-0.5 transition-transform font-black">
          ↓
        </span>
      </button>
      <div class="mt-3">
        <span id="load-more-counter" class="text-xs font-semibold text-slate-400">
          Afișezi 12 din {deals.length} oferte
        </span>
      </div>
    </div>

    <!-- No Deals Found State (Hidden by default) -->
    <div id="no-deals-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8">
      <div class="text-5xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Nu am găsit oferte pentru această combinație</h3>
      <p class="text-sm text-slate-500 mb-4">Încearcă să alegi alt oraș de plecare sau să mărești bugetul.</p>
      <button 
        id="btn-reset-state" 
        class="px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-rose-600 transition-colors"
      >
        Afișează toate ofertele
      </button>
    </div>
  </section>

  <!-- Agoda & Kiwi Official Partner Banners -->
  <AgodaBanner />
  <KiwiBanner />

  <!-- Community Callout: Telegram + WhatsApp -->
  <CommunityBanner />

  <!-- Email Newsletter Subscription -->
  <Newsletter />

  <!-- Client-side filter script -->
  <script is:inline>
    const filterSearch = document.getElementById('filter-search');
    const filterOrigin = document.getElementById('filter-origin');
    const filterBudget = document.getElementById('filter-budget');
    const filterCategory = document.getElementById('filter-category');
    const btnReset = document.getElementById('btn-reset-filters');
    const btnResetState = document.getElementById('btn-reset-state');
    const cards = Array.from(document.querySelectorAll('.deal-card'));
    const noDealsState = document.getElementById('no-deals-state');
    const badge = document.getElementById('active-deals-badge');
    const transportTabs = document.querySelectorAll('.transport-tab');

    // Load More Elements
    const loadMoreContainer = document.getElementById('load-more-container');
    const btnLoadMore = document.getElementById('btn-load-more');
    const loadMoreText = document.getElementById('load-more-text');
    const loadMoreCounter = document.getElementById('load-more-counter');

    const PAGE_SIZE = 12;
    let visibleLimit = PAGE_SIZE;
    let currentTransport = 'all';

    function updateOriginOptions(transportMode) {
      if (!filterOrigin) return;
      const originLabel = document.getElementById('filter-origin-label');
      const isCar = (transportMode === 'car');
      
      if (originLabel) {
        originLabel.innerHTML = isCar ? '🚗 Oraș de plecare' : '🛫 Oraș de plecare';
      }

      const options = filterOrigin.querySelectorAll('option');
      options.forEach(opt => {
        if (opt.value === 'all') {
          opt.textContent = 'Toate orașele din România';
          return;
        }
        const city = opt.dataset.city || opt.value;
        const code = opt.dataset.code;
        if (isCar || !code) {
          opt.textContent = city;
        } else {
          opt.textContent = `${city} (${code})`;
        }
      });
    }

    function setTransport(val) {
      currentTransport = val;
      transportTabs.forEach(tab => {
        const isMatch = (tab.dataset.transport === val);
        if (isMatch) {
          tab.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-sm', 'font-bold');
          tab.classList.remove('text-slate-600', 'font-medium', 'hover:bg-white/60');
        } else {
          tab.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-sm', 'font-bold');
          tab.classList.add('text-slate-600', 'font-medium', 'hover:bg-white/60');
        }
      });
      updateOriginOptions(val);
      visibleLimit = PAGE_SIZE;
      applyFilters();
    }

    transportTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        setTransport(tab.dataset.transport || 'all');
      });
    });

    function applyFilters() {
      const query = (filterSearch?.value || '').trim().toLowerCase();
      const selectedOrigin = filterOrigin?.value || 'all';
      const selectedBudget = filterBudget?.value || 'all';
      const selectedCategory = filterCategory?.value || 'all';

      // 1. Filter matching cards
      const matchingCards = [];
      const nonMatchingCards = [];

      cards.forEach(card => {
        const origin = card.dataset.origin;
        const category = card.dataset.category;
        const price = parseFloat(card.dataset.price);
        const cardTransport = card.dataset.transport || 'flight';
        const cardText = card.innerText.toLowerCase();

        const matchSearch = (!query || cardText.includes(query));
        const matchOrigin = (selectedOrigin === 'all' || origin === selectedOrigin);
        const matchCategory = (selectedCategory === 'all' || (category && category.toLowerCase().includes(selectedCategory.toLowerCase())));
        const matchBudget = (selectedBudget === 'all' || price <= parseFloat(selectedBudget));
        const matchTransport = (currentTransport === 'all' || cardTransport === currentTransport);

        if (matchSearch && matchOrigin && matchCategory && matchBudget && matchTransport) {
          matchingCards.push(card);
        } else {
          nonMatchingCards.push(card);
        }
      });

      // Always hide non-matching
      nonMatchingCards.forEach(c => c.classList.add('hidden'));

      // 2. Paginate matching cards
      const totalMatches = matchingCards.length;
      const countToShow = Math.min(visibleLimit, totalMatches);

      matchingCards.forEach((card, index) => {
        if (index < countToShow) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Update badge count
      if (badge) {
        if (totalMatches === countToShow) {
          badge.innerText = `${totalMatches} oferte afișate`;
        } else {
          badge.innerText = `${countToShow} din ${totalMatches} oferte afișate`;
        }
      }

      // 3. Update Load More button state
      if (loadMoreContainer) {
        if (countToShow < totalMatches) {
          loadMoreContainer.classList.remove('hidden');
          const remaining = totalMatches - countToShow;
          const nextBatch = Math.min(PAGE_SIZE, remaining);
          if (loadMoreText) {
            loadMoreText.innerText = `Afișează încă ${nextBatch} oferte`;
          }
          if (loadMoreCounter) {
            loadMoreCounter.innerText = `Afișezi ${countToShow} din ${totalMatches} oferte disponibile (au mai rămas ${remaining})`;
          }
        } else {
          loadMoreContainer.classList.add('hidden');
        }
      }

      // Show / hide empty state
      if (totalMatches === 0) {
        if (noDealsState) noDealsState.classList.remove('hidden');
      } else {
        if (noDealsState) noDealsState.classList.add('hidden');
      }

      // Show reset button if any filter is active
      const isFiltered = (query !== '' || selectedOrigin !== 'all' || selectedBudget !== 'all' || selectedCategory !== 'all' || currentTransport !== 'all');
      if (btnReset) {
        if (isFiltered) {
          btnReset.classList.remove('hidden');
        } else {
          btnReset.classList.add('hidden');
        }
      }
    }

    // Handle "Load More" click
    if (btnLoadMore) {
      btnLoadMore.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters();
      });
    }

    function resetFilters() {
      if (filterSearch) filterSearch.value = '';
      if (filterOrigin) filterOrigin.value = 'all';
      if (filterBudget) filterBudget.value = 'all';
      if (filterCategory) filterCategory.value = 'all';
      visibleLimit = PAGE_SIZE;
      setTransport('all');
      updateCityPills('all');
    }

    // City pills selector sync
    const cityPills = document.querySelectorAll('.city-pill');
    function updateCityPills(selectedCity) {
      cityPills.forEach(p => {
        const match = (p.dataset.city === selectedCity);
        if (match) {
          p.classList.add('bg-slate-900', 'text-white');
          p.classList.remove('bg-white', 'text-slate-700');
        } else {
          p.classList.remove('bg-slate-900', 'text-white');
          p.classList.add('bg-white', 'text-slate-700');
        }
      });
    }

    cityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const city = pill.dataset.city || 'all';
        if (filterOrigin) {
          filterOrigin.value = city;
        }
        updateCityPills(city);
        applyFilters();
      });
    });

    // Trending search chips from hero
    const heroChips = document.querySelectorAll('.hero-chip');
    heroChips.forEach(chip => {
      chip.addEventListener('click', () => {
        if (chip.dataset.budget && filterBudget) {
          filterBudget.value = chip.dataset.budget;
        }
        if (chip.dataset.category && filterCategory) {
          filterCategory.value = chip.dataset.category;
        }
        if (chip.dataset.query && filterSearch) {
          filterSearch.value = chip.dataset.query;
        }
        applyFilters();
        const dealsGrid = document.getElementById('deals-grid');
        if (dealsGrid) {
          dealsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    if (filterSearch) filterSearch.addEventListener('input', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
    if (filterOrigin) {
      filterOrigin.addEventListener('change', () => {
        updateCityPills(filterOrigin.value);
        visibleLimit = PAGE_SIZE;
        applyFilters();
      });
    }
    if (filterBudget) filterBudget.addEventListener('change', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
    if (filterCategory) filterCategory.addEventListener('change', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
    if (btnReset) btnReset.addEventListener('click', resetFilters);
    if (btnResetState) btnResetState.addEventListener('click', resetFilters);

    // Initial page load limit to 12 deals
    applyFilters();
  </script>
</Layout>
