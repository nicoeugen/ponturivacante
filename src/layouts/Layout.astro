---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Călătorește pe cont propriu la jumătate de preț: oferte verificate de zbor low-cost + cazare, city break-uri europene, destinații exotice, schi, croaziere și cabane în România. Calculator live de buget pe fiecare ofertă.",
  image = "https://ponturivacante.ro/og-image.jpg?v=2"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ponturivacante.ro');

// Imagine optimizată pentru Telegram, WhatsApp și rețele sociale
// Pentru Unsplash folosim un singur parametru w=1200 (fără entități &amp;) pentru a menține dimensiunea sub 500 KB (Telegram respinge preview-uri > 5MB)
const ogImage = (() => {
  let img = image.startsWith('http') ? image : `https://ponturivacante.ro${image}`;
  if (img.includes('images.unsplash.com')) {
    const baseUrl = img.split('?')[0];
    return `${baseUrl}?w=1200`;
  }
  return img;
})();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PonturiVacanțe",
  "url": "https://ponturivacante.ro",
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ponturivacante.ro/?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#e11d48" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} — PonturiVacanțe</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="PonturiVacanțe RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PonturiVacanțe — Călătorește pe cont propriu la jumătate de preț" />
    <meta property="og:site_name" content="PonturiVacanțe" />
    <meta property="og:locale" content="ro_RO" />
    <link rel="image_src" href={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Travelpayouts Drive Integration -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://tpembars.com/NTk2ODcy.js?t=596872';
          document.head.appendChild(script);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
