    </a>
    <!-- Festive Quick Badges in Mobile Menu -->
    <div class="py-2 px-1 flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <a href="/categorie/1-decembrie/" class="px-2.5 py-1.5 rounded-lg bg-rose-50 text-rose-700 text-xs font-bold whitespace-nowrap border border-rose-200 shadow-2xs">
        🇷🇴 1 Decembrie
