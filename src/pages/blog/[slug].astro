---
import Layout from '../../layouts/Layout.astro';
import CommunityBanner from '../../components/CommunityBanner.astro';
import AgodaBanner from '../../components/AgodaBanner.astro';
import KiwiBanner from '../../components/KiwiBanner.astro';
import Newsletter from '../../components/Newsletter.astro';
import articles from '../../../data/blog_articles.json';
import deals from '../../../data/deals.json';

export async function getStaticPaths() {
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

// Identificăm ofertele relevante din catalog pentru acest articol
const tag = (article.tag || '').toLowerCase();
const relatedDeals = deals.filter(d => {
  const dest = (d.destination || '').toLowerCase();
  const country = (d.country || '').toLowerCase();
  const slug = (d.slug || '').toLowerCase();
  const cat = (d.category || '').toLowerCase();

  if (tag.includes('1 decembrie')) {
    return cat.includes('1 decembrie') || slug.includes('1-decembrie') || dest.includes('viena') || dest.includes('budapesta') || dest.includes('roma');
  }
  if (tag.includes('craciun') || tag.includes('crăciun')) {
    return cat.includes('craciun') || slug.includes('craciun') || slug.includes('targ') || dest.includes('colmar') || dest.includes('praga') || dest.includes('viena');
  }
  if (tag.includes('revelion')) {
    return cat.includes('revelion') || slug.includes('revelion');
  }
  if (tag === 'egipt') {
    return country.includes('egipt') || dest.includes('hurghada') || dest.includes('sharm') || dest.includes('cairo');
  }
  if (tag === 'schi') {
    return cat.includes('schi') || slug.includes('schi');
  }
  if (tag === 'roma') {
    return dest.includes('roma') || slug.includes('roma');
  }
  if (tag === 'londra') {
    return dest.includes('londra') || slug.includes('londra');
  }
  if (tag === 'cipru') {
    return country.includes('cipru') || dest.includes('paphos') || dest.includes('larnaca');
  }
  if (tag === 'maldive' || tag === 'exotice') {
    return cat.includes('exotic') || dest.includes('maldive') || dest.includes('tenerife') || dest.includes('dubai');
  }
  if (tag === 'croaziere') {
    return cat.includes('croazier');
  }
  if (tag && (dest.includes(tag) || country.includes(tag) || slug.includes(tag))) {
    return true;
  }
  return false;
}).slice(0, 3);

// Dacă nu există potrivire directă pe destinație, afișăm 3 oferte de top featured
const displayDeals = relatedDeals.length > 0 
  ? relatedDeals 
  : deals.filter(d => d.featured).slice(0, 3);
---

<Layout 
  title={`${article.title} — Blog PonturiVacanțe`}
  description={article.excerpt}
  image={article.image}
>
  <article class="pb-16">
    <!-- Breadcrumb -->
    <div class="bg-slate-100 border-b border-slate-200 py-3">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-xs text-slate-500 flex items-center gap-2">
        <a href="/" class="hover:text-rose-600 transition-colors">Acasă</a>
        <span>/</span>
        <a href="/blog" class="hover:text-rose-600 transition-colors">Blog</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold truncate">{article.title}</span>
      </div>
    </div>

    <!-- Article Header -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="px-2.5 py-1 rounded-full bg-rose-600 text-white text-xs font-black shadow-sm">
          {article.tag}
        </span>
        <span class="px-2.5 py-1 rounded-full bg-slate-900 text-white text-xs font-semibold">
          {article.category}
        </span>
        <span class="text-xs text-slate-400 ml-auto">
          ⏱️ {article.readTime}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        {article.title}
      </h1>

      <p class="text-base text-slate-600 leading-relaxed mb-6 font-medium">
        {article.excerpt}
      </p>

      <div class="flex items-center gap-3 text-xs text-slate-500 border-y border-slate-200 py-3 mb-8">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white text-xs font-bold">
          ✈️
        </div>
        <div>
          <span class="font-bold text-slate-900 block">{article.author}</span>
          <span class="text-[11px] text-slate-400">Actualizat recent</span>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="rounded-3xl overflow-hidden mb-10 shadow-xl max-h-[440px]">
        <img 
          src={article.image} 
          alt={article.title} 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Article Content Body -->
      <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-6 text-sm sm:text-base">
        {article.content.map(block => {
          if (block.type === 'h2') {
            return <h2 class="text-xl sm:text-2xl font-black text-slate-900 pt-4 mt-6 border-t border-slate-100">{block.text}</h2>;
          }
          return <p class="leading-relaxed">{block.text}</p>;
        })}
      </div>

      <!-- Secțiune Oferte Relevante pentru Destinația Articolului -->
      {displayDeals.length > 0 && (
        <div class="mt-14 pt-10 border-t-2 border-slate-100">
          <div class="flex items-center justify-between mb-6">
            <div>
              <span class="text-xs font-black text-rose-600 uppercase tracking-wider block mb-1">
                {relatedDeals.length > 0 ? `🎯 Oferte Active pentru ${article.tag}` : '🔥 Oferte Populare Recomandate'}
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                Pune în practică: Vacanțe verificate gata de rezervare
              </h3>
            </div>
            <a 
              href="/" 
              class="hidden sm:inline-flex text-xs font-bold text-slate-500 hover:text-slate-900 transition-colors"
            >
              Toate ofertele &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {displayDeals.map(d => (
              <a 
                href={`/oferta/${d.slug}/`}
                class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="relative h-32 overflow-hidden bg-slate-100">
                    <img 
                      src={d.image} 
                      alt={d.destination} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                    <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-sm text-white text-[10px] font-black">
                      {d.badge || d.category}
                    </div>
                  </div>
                  <div class="p-3.5">
                    <h4 class="font-bold text-xs sm:text-sm text-slate-900 leading-snug mb-1 group-hover:text-rose-600 transition-colors line-clamp-2">
                      {d.title}
                    </h4>
                    <p class="text-[11px] text-slate-500 mb-2">
                      {d.originCity ? `Din ${d.originCity}` : 'România'} &bull; {d.dates}
                    </p>
                  </div>
                </div>

                <div class="p-3.5 pt-0 flex items-baseline justify-between border-t border-slate-50 mt-1">
                  <div>
                    <span class="text-base font-black text-rose-600">{d.priceTotalPerPerson} €</span>
                    <span class="text-[10px] text-slate-400 block -mt-1">/persoană</span>
                  </div>
                  <span class="text-[11px] font-bold text-slate-700 group-hover:text-rose-600 flex items-center gap-0.5">
                    Detalii &rarr;
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Callout: Scanează toate ofertele -->
      <div class="bg-gradient-to-r from-rose-50 to-amber-50 rounded-3xl p-6 sm:p-8 border border-rose-200/80 my-10 text-center">
        <span class="text-2xl mb-2 block">✈️</span>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Vrei să explorezi mai multe destinații?</h3>
        <p class="text-xs sm:text-sm text-slate-600 mb-6 max-w-md mx-auto">
          Scanează catalogul complet cu 46+ oferte verificate de zbor + cazare cu plecare din 8 aeroporturi din România de la 74€!
        </p>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-sm shadow-md"
        >
          <span>Vezi Toate Ofertele din Catalog</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Context-Aware Partner Banners (Kiwi for flights, Agoda for destinations) -->
    {article.slug.includes('avion') || article.slug.includes('bilete') ? (
      <KiwiBanner subtitle="Vrei să găsești cele mai ieftine bilete de avion? Caută rute și conexiuni inteligente pe Kiwi.com." />
    ) : (
      <AgodaBanner destination={article.tag} subtitle={`Planifici o vacanță în ${article.tag || 'destinația ta preferată'}? Descoperă hotelurile și resorturile verificate pe Agoda cu cel mai bun tarif garantat.`} />
    )}

    <!-- Community & Newsletter -->
    <CommunityBanner />
    <Newsletter />
  </article>
</Layout>
