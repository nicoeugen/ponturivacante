---
import Layout from '../../layouts/Layout.astro';
import DealCard from '../../components/DealCard.astro';
import RomaniaCard from '../../components/RomaniaCard.astro';
import CommunityBanner from '../../components/CommunityBanner.astro';
import deals from '../../../data/deals.json';
import romaniaDeals from '../../../data/romania_deals.json';

export function getStaticPaths() {
  const categories = [
    { 
      slug: '1-decembrie', 
      name: 'Minivacanța de 1 Decembrie', 
      icon: '🇷🇴', 
      badge: '🎆 Weekend Prelungit (28 Nov – 1 Dec)',
      desc: 'Oferte speciale pentru minivacanța de Sfântul Andrei și Ziua Națională a României (sâmbătă 28 noiembrie – marți 1 decembrie). City break-uri la Târgurile de Crăciun, capitale europene și relaxare la munte & spa.' 
    },
    { 
      slug: 'targuri-craciun', 
      name: 'Târguri de Crăciun Europene', 
      icon: '🎄', 
      badge: '✨ Sezon Noiembrie – Decembrie',
      desc: 'Cele mai festive și spectaculoase piețe de Crăciun din Europa: Viena, Budapesta, Praga, Nürnberg, Colmar & Alsacia. Vin fiert cu scorțișoară, luminițe de poveste și cazări la pași de târg.' 
    },
    { 
      slug: 'revelion', 
      name: 'Revelion 2027 pe Cont Propriu', 
      icon: '🎆', 
      badge: '🥂 Noaptea Dintre Ani',
      desc: 'Petrece Revelionul fără să plătești tarife exagerate de agenție: croazieră pe Bosfor în Istanbul, artificii peste Acropole în Atena, petrecere la zăpadă în Bansko sau soare în Dubai.' 
    },
    { 
      slug: 'exotice', 
      name: 'Exotic & Soare de Iarnă', 
      icon: '🌴', 
      badge: '☀️ Sezon Decembrie – Februarie',
      desc: 'Evadări la soare și plajă în miezul iernii: Dubai, Abu Dhabi, Tenerife, Canare, Maldive, Iordania, Egipt, Maroc, Madeira și Zanzibar la prețuri pe cont propriu.' 
    },
    { 
      slug: 'schi', 
      name: 'Schi & Sporturi de Iarnă', 
      icon: '🎿', 
      badge: '⛷️ Sezon Decembrie – Martie',
      desc: 'Top destinații de schi din Europa și România: Bansko, Dolomiți / Val di Fassa, Tirolul Austriac, Jasna Tatra și Carpații Românești. Zboruri convenabile + cazări lângă pârtii și telegondolă.' 
    },
    { 
      slug: 'city-break', 
      name: 'City Break', 
      icon: '🏙️', 
      badge: 'Capitale & Cultură',
      desc: 'Escapade urbane de 2-4 nopți în marile capitale și orașe istorice europene: Roma, Milano, Barcelona, Viena, Londra, Paris, Praga.' 
    },
    { 
      slug: 'mare-si-soare', 
      name: 'Mare & Soare', 
      icon: '🏖️', 
      badge: 'Litoral & Plajă',
      desc: 'Vacanțe la plajă și soare pe coastele Mediteranei și insulele europene: Cipru, Malta, Grecia, Spania și Italia.' 
    },
    { 
      slug: 'weekend', 
      name: 'Weekend Break', 
      icon: '⚡', 
      badge: 'Plecări Vineri - Duminică',
      desc: 'Plecări rapide de sfârșit de săptămână fără a fi nevoie să îți iei multe zile libere de la serviciu.' 
    },
  ];

  return categories.map(cat => {
    const catDeals = deals.filter(d => {
      const dealCat = (d.category || '').toLowerCase();
      const titleLower = (d.title || '').toLowerCase();
      const badgeLower = (d.badge || '').toLowerCase();
      const datesLower = (d.dates || '').toLowerCase();

      if (cat.slug === '1-decembrie') {
        return dealCat.includes('1 decembrie') || titleLower.includes('1 decembrie') || badgeLower.includes('1 decembrie') || datesLower.includes('28 noiembrie');
      }
      if (cat.slug === 'targuri-craciun') {
        return dealCat.includes('craciun') || dealCat.includes('crăciun') || titleLower.includes('craciun') || titleLower.includes('crăciun') || badgeLower.includes('crăciun');
      }
      if (cat.slug === 'revelion') {
        return dealCat.includes('revelion') || titleLower.includes('revelion') || badgeLower.includes('revelion') || datesLower.includes('30 decembrie');
      }
      if (cat.slug === 'exotice') {
        return dealCat.includes('exotic') || titleLower.includes('exotic') || ['maldive', 'zanzibar', 'abu dhabi', 'dubai', 'tenerife', 'canare', 'aqaba', 'egipt', 'hurghada', 'marrakech', 'madeira'].some(dest => d.destination.toLowerCase().includes(dest));
      }
      if (cat.slug === 'schi') {
        return dealCat.includes('schi') || dealCat.includes('ski') || ['bansko', 'dolomiti', 'tirol', 'innsbruck', 'jasna', 'tatry', 'alpi'].some(dest => d.destination.toLowerCase().includes(dest) || d.title.toLowerCase().includes(dest));
      }
      return dealCat.includes(cat.name.toLowerCase()) || dealCat.includes(cat.slug);
    });

    return {
      params: { category: cat.slug },
      props: { cat, deals: catDeals }
    };
  });
}

const { cat, deals: catDeals } = Astro.props;

const roSkiDeals = (() => {
  if (cat.slug === 'schi') {
    return romaniaDeals.filter(r => r.category.toLowerCase().includes('schi') || r.title.toLowerCase().includes('schi'));
  }
  if (cat.slug === '1-decembrie') {
    return romaniaDeals.filter(r => r.title.toLowerCase().includes('sibiu') || r.title.toLowerCase().includes('craciun') || r.category.toLowerCase().includes('cabana'));
  }
  if (cat.slug === 'targuri-craciun') {
    return romaniaDeals.filter(r => r.title.toLowerCase().includes('sibiu') || r.title.toLowerCase().includes('craciun'));
  }
  if (cat.slug === 'revelion') {
    return romaniaDeals.filter(r => r.title.toLowerCase().includes('ciubar') || r.category.toLowerCase().includes('cabana') || r.title.toLowerCase().includes('castel'));
  }
  return [];
})();
---

<Layout 
  title={`${cat.name} — Vacanțe Zbor + Cazare`}
  description={cat.desc}
>
  <section class="gradient-hero text-white py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur border border-white/20 text-xs font-bold uppercase tracking-wider mb-4">
        <span>{cat.icon} {cat.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-3">
        Oferte <span class="text-amber-300">{cat.name}</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        {cat.desc}
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Secțiune Dedicată: Cazări de Schi în România (dacă suntem pe categoria Schi) -->
    {cat.slug === 'schi' && roSkiDeals.length > 0 && (
      <div class="mb-14">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-white border border-emerald-200">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-600 text-white text-[11px] font-black uppercase tracking-wider mb-1">
              <span>🇷🇴 România</span>
              <span>•</span>
              <span>Vouchere de Vacanță</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Pârtii & Cazări de Schi în România ({roSkiDeals.length})
            </h2>
            <p class="text-xs text-slate-600">
              Weekend-uri la schi și cazări aproape de pârtii în Poiana Brașov, Sinaia, Straja și Păltiniș. Plata acceptată cu card de vacanță.
            </p>
          </div>
          <a 
            href="/romania/?category=schi" 
            class="shrink-0 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md transition-all whitespace-nowrap text-center"
          >
            Filtrează doar Schi România &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {roSkiDeals.map(deal => (
            <RomaniaCard deal={deal} />
          ))}
        </div>
      </div>
    )}

    <!-- Secțiune Destinații Internaționale -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          {cat.slug === 'schi' ? `Destinații Internaționale de Schi & Alpi (${catDeals.length})` : `Oferte disponibile (${catDeals.length})`}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          {cat.slug === 'schi' ? 'Bansko Bulgaria, Austria (Tirol, Kitzbühel, Zell am See), Dolomiți Italia, Slovacia și Alpii Francezi.' : 'Zboruri dus-întors și cazări verificate selectate pentru această categorie.'}
        </p>
      </div>
      <a href="/" class="text-xs font-bold text-rose-600 hover:underline">
        &larr; Vezi toate ofertele
      </a>
    </div>

    {catDeals.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {catDeals.map(deal => (
          <DealCard deal={deal} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 max-w-xl mx-auto">
        <div class="text-5xl mb-3">🎿</div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">Se actualizează ofertele</h3>
        <p class="text-sm text-slate-500 mb-6">
          Scanăm în mod continuu rutele de iarnă.
        </p>
        <a 
          href="/" 
          class="inline-block px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-rose-600 transition-colors"
        >
          &larr; Vezi toate ofertele
        </a>
      </div>
    )}
  </section>

  <CommunityBanner />
</Layout>
