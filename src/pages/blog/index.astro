---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CommunityBanner from '../../components/CommunityBanner.astro';
import Newsletter from '../../components/Newsletter.astro';
import articles from '../../../data/blog_articles.json';
---

<Layout 
  title="Blog & Ghiduri de Călătorie pe Cont Propriu (DIY)"
  description="Articole, trucuri de zbor ieftin cu Wizz și Ryanair, ghiduri de croaziere și itinerarii pas cu pas pentru vacanțe inteligente."
>
  <!-- Hero Section -->
  <section class="gradient-hero text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rose-500/20 backdrop-blur border border-rose-400/30 text-xs sm:text-sm font-bold text-rose-200 mb-6 shadow-md">
        <span>📝 GHIDURI & TRUCURI DE CĂLĂTORIE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight mb-4">
        Învață să călătorești <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-rose-300">mai mult și mai ieftin</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Ghiduri complete scrise de călători pasionați: cum funcționează algoritmii low-cost, ce bagaje trec gratuit la poartă și cum organizezi o vacanță de lux cu buget redus.
      </p>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Toate Articolele ({articles.length})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Informații utile, practice și testate direct pe rutele din România.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map(article => (
        <BlogCard article={article} />
      ))}
    </div>
  </section>

  <!-- Community & Newsletter -->
  <CommunityBanner />
  <Newsletter />
</Layout>
