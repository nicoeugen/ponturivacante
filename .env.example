# 1. API Căutare Zboruri (Kiwi.com Tequila API — Înregistrare gratuită pe https://tequila.kiwi.com/)
TEQUILA_API_KEY=cheia_ta_tequila_aici

# 2. Marketing Afiliat (Travelpayouts & Booking)
# Creează cont pe https://www.travelpayouts.com/
TRAVELPAYOUTS_MARKER=123456
BOOKING_AID=000000

# 3. Notificări Automate Telegram (Creat prin @BotFather pe Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHANNEL_ID=@canalul_tau_de_vacante

# 4. Webhook Opțional Newsletter (ex: Mailchimp, Brevo, Beehiiv sau Zapier)
NEWSLETTER_WEBHOOK_URL=https://hook.eu1.make.com/...
