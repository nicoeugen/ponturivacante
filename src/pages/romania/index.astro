---
import Layout from '../../layouts/Layout.astro';
import RomaniaCard from '../../components/RomaniaCard.astro';
import CommunityBanner from '../../components/CommunityBanner.astro';
import Newsletter from '../../components/Newsletter.astro';
import romaniaDeals from '../../../data/romania_deals.json';
---

<Layout 
  title="Cazări de Poveste în România — Cabane cu Ciubăr, Conace & Spa"
  description="Descoperă cele mai frumoase cabane A-frame din România, conace boierești, pensiuni tradiționale din Maramureș și resorturi spa termale. Cazări verificate cu plata prin vouchere de vacanță."
>
  <!-- Hero Section -->
  <section class="gradient-hero text-white pt-6 sm:pt-8 pb-10 sm:pb-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 backdrop-blur border border-emerald-400/30 text-xs sm:text-sm font-bold text-emerald-200 mb-3.5 shadow-md">
        <span>🇷🇴 TURISM ÎN ROMÂNIA</span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight mb-2.5">
        Cazări de Poveste & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-amber-300 to-amber-200">Escapade de Weekend</span>
      </h1>

      <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto mb-5 leading-relaxed">
        Nu trebuie să iei avionul ca să ai o vacanță magică! Am selectat cele mai spectaculoase cabane cu ciubăr la munte, weekend-uri la schi pe pârtiile din Carpați, conace istorice și resorturi termale din România.
      </p>

      <!-- Fast Filters Box (Urcată mai sus) -->
      <div class="bg-white/95 backdrop-blur p-4 sm:p-5 rounded-2xl shadow-2xl border border-white/30 text-slate-800 max-w-4xl mx-auto space-y-3 text-left">
        <!-- Search Input -->
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-base">
            🔍
          </span>
          <input 
            type="text" 
            id="filter-ro-search" 
            placeholder="Caută destinație din România (ex: Poiana Brașov, Sinaia, Straja, Apuseni, Felix, Maramureș...)" 
            class="w-full bg-slate-100 border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 text-sm font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
          <!-- Filter Category -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
              🏡 Tipul de experiență
            </label>
            <select 
              id="filter-ro-category"
              class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
            >
              <option value="all">Toate experiențele din România</option>
              <option value="Schi & Pârtii">🎿 Schi & Pârtii (Poiana, Sinaia, Straja, Păltiniș)</option>
              <option value="Cabane & A-Frame">🔥 Cabane cu Ciubăr & A-Frame</option>
              <option value="Spa & Termal">♨️ Spa & Ape Termale (Felix)</option>
              <option value="Conace & Castele">👑 Conace Boierești & Castele</option>
              <option value="Tradițional & Sat Românesc">🌾 Maramureș & Tradiție</option>
              <option value="City Break România">🎄 City Break & Târguri Crăciun</option>
            </select>
          </div>

          <!-- Voucher Checkbox -->
          <div class="flex items-center justify-start sm:justify-end pt-1 sm:pt-5">
            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 px-3.5 py-2.5 rounded-xl border border-slate-200 transition-colors w-full sm:w-auto justify-center">
              <input 
                type="checkbox" 
                id="filter-ro-voucher" 
                class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500 cursor-pointer"
              />
              <span>💳 Doar cu Vouchere Vacanță</span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Cazări Recomandate în România ({romaniaDeals.length})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Selectate manual pentru recenzii peste 8.5, peisaj spectaculos și ospitalitate.
        </p>
      </div>

      <span id="ro-deals-badge" class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold">
        {romaniaDeals.length} disponibile
      </span>
    </div>

    <div id="ro-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {romaniaDeals.map(deal => (
        <RomaniaCard deal={deal} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="ro-empty" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 max-w-md mx-auto">
      <div class="text-5xl mb-3">🏡</div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Nu am găsit cazări cu aceste criterii</h3>
      <p class="text-xs text-slate-500 mb-4">Încearcă să debifezi filtrul de carduri de vacanță sau alege altă categorie.</p>
      <button 
        id="btn-ro-reset"
        class="px-5 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-emerald-600 transition-colors cursor-pointer"
      >
        Resetează filtrele
      </button>
    </div>
  </section>

  <!-- Community & Newsletter -->
  <CommunityBanner />
  <Newsletter />

  <!-- Client-side filter script -->
  <script is:inline>
    const filterSearch = document.getElementById('filter-ro-search');
    const filterCat = document.getElementById('filter-ro-category');
    const filterVoucher = document.getElementById('filter-ro-voucher');
    const cards = document.querySelectorAll('.romania-card');
    const emptyState = document.getElementById('ro-empty');
    const badge = document.getElementById('ro-deals-badge');
    const btnReset = document.getElementById('btn-ro-reset');

    function applyRoFilters() {
      const query = (filterSearch?.value || '').trim().toLowerCase();
      const selectedCat = filterCat.value;
      const requireVoucher = filterVoucher.checked;
      let count = 0;

      cards.forEach(card => {
        const cat = card.dataset.category || '';
        const hasVoucher = card.dataset.voucher === 'true';
        const cardText = card.innerText.toLowerCase();

        const matchSearch = (!query || cardText.includes(query));
        const matchCat = (selectedCat === 'all' || cat.toLowerCase().includes(selectedCat.toLowerCase()));
        const matchVoucher = (!requireVoucher || hasVoucher);

        if (matchSearch && matchCat && matchVoucher) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (badge) badge.innerText = `${count} disponibile`;
      if (count === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    function resetRoFilters() {
      if (filterSearch) filterSearch.value = '';
      filterCat.value = 'all';
      filterVoucher.checked = false;
      applyRoFilters();
    }

    filterSearch?.addEventListener('input', applyRoFilters);
    filterCat?.addEventListener('change', applyRoFilters);
    filterVoucher?.addEventListener('change', applyRoFilters);
    btnReset?.addEventListener('click', resetRoFilters);
  </script>
</Layout>
