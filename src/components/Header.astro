---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo (Stânga) -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0 md:w-[200px]">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white text-xl shadow-md group-hover:scale-105 transition-transform">
        ✈️
      </div>
      <div>
        <span class="font-extrabold text-xl tracking-tight text-slate-900 group-hover:text-rose-600 transition-colors whitespace-nowrap">
          Ponturi<span class="text-rose-500">Vacanțe</span>
        </span>
        <span class="hidden sm:block text-[10px] font-semibold tracking-wider text-slate-400 uppercase -mt-1 whitespace-nowrap">
          Zbor + Cazare Ieftină
        </span>
      </div>
    </a>

    <!-- Navigation Desktop (Centrat Perfect) -->
    <nav class="hidden md:flex items-center justify-center gap-5 lg:gap-7 xl:gap-8 text-sm font-semibold text-slate-600 whitespace-nowrap flex-1">
      <a href="/" class="hover:text-rose-600 transition-colors">Toate Ofertele</a>
      <a href="/categorie/city-break/" class="text-rose-600 hover:text-rose-700 flex items-center gap-1.5 font-bold transition-colors">
        <span>🏛️</span> City Break
      </a>
      <a href="/romania/" class="text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5 font-bold transition-colors">
        <span>🇷🇴</span> România
      </a>
      <a href="/categorie/schi/" class="text-sky-700 hover:text-sky-800 flex items-center gap-1.5 font-bold transition-colors">
        <span>🎿</span> Schi
      </a>
      <a href="/categorie/exotice/" class="text-amber-600 hover:text-amber-700 flex items-center gap-1.5 font-bold transition-colors">
        <span>🌴</span> Exotice
      </a>
      <a href="/croaziere/" class="text-indigo-600 hover:text-indigo-700 flex items-center gap-1.5 font-bold transition-colors">
        <span>🚢</span> Croaziere
      </a>
      <a href="/blog/" class="hover:text-rose-600 transition-colors flex items-center gap-1.5">
        <span>📝</span> Blog
      </a>
    </nav>

    <!-- CTA Canal WhatsApp (Desktop) -->
    <div class="hidden md:flex items-center justify-end md:w-[200px]">
      <a 
        href="https://whatsapp.com/channel/0029VbDiXkq2v1IzPRElgC0q" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold border border-emerald-200 transition-all hover:scale-105 shadow-xs"
        title="Urmărește alertele de vacanțe pe WhatsApp"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Canal WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button (Vizibil doar pe mobil) -->
    <button 
      id="mobile-menu-btn" 
      type="button" 
      class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer"
      aria-label="Deschide meniul de navigare"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/98 backdrop-blur px-4 pt-3 pb-6 space-y-1 shadow-xl">
    <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-slate-900 hover:bg-slate-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center text-sm">🌟</span>
      <span>Toate Ofertele</span>
    </a>
    <a href="/categorie/city-break/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-rose-600 hover:bg-rose-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-rose-50 flex items-center justify-center text-sm">🏛️</span>
      <span>City Break</span>
    </a>
    <a href="/romania/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-emerald-700 hover:bg-emerald-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center text-sm">🇷🇴</span>
      <span>România (Cabane & Spa)</span>
    </a>
    <a href="/categorie/schi/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-sky-700 hover:bg-sky-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-sky-50 flex items-center justify-center text-sm">🎿</span>
      <span>Sezon Schi</span>
    </a>
    <a href="/categorie/exotice/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-amber-700 hover:bg-amber-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-amber-50 flex items-center justify-center text-sm">🌴</span>
      <span>Exotice & Soare</span>
    </a>
    <a href="/croaziere/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-indigo-700 hover:bg-indigo-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-indigo-50 flex items-center justify-center text-sm">🚢</span>
      <span>Croaziere</span>
    </a>
    <a href="/blog/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors">
      <span class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center text-sm">📝</span>
      <span>Blog & Ghiduri</span>
    </a>
    <div class="pt-2 mt-2 border-t border-slate-100">
      <a 
        href="https://whatsapp.com/channel/0029VbDiXkq2v1IzPRElgC0q" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Abonează-te pe WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu) {
      btn.addEventListener('click', function() {
        const isClosed = menu.classList.contains('hidden');
        if (isClosed) {
          menu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
        } else {
          menu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    }
  })();
</script>
