---
import Layout from '../../layouts/Layout.astro';
import DealCard from '../../components/DealCard.astro';
import TelegramBanner from '../../components/TelegramBanner.astro';
import KiwiBanner from '../../components/KiwiBanner.astro';
import deals from '../../../data/deals.json';
import airports from '../../../data/airports.json';

export function getStaticPaths() {
  const slugify = (text) => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-');
  
  return airports.map(airport => {
    const slug = slugify(airport.city);
    const cityDeals = deals.filter(d => 
      slugify(d.originCity) === slug || d.originCode === airport.code
    );
    return {
      params: { city: slug },
      props: { airport, deals: cityDeals }
    };
  });
}

const { airport, deals: cityDeals } = Astro.props;
const otherAirports = airports.filter(a => a.code !== airport.code);
---

<Layout 
  title={`Vacanțe & Zboruri Ieftine din ${airport.city} (${airport.code})`}
  description={`Descoperă ofertele de zbor + cazare cu plecare de pe aeroportul ${airport.name} din ${airport.city}. City break-uri și vacanțe ieftine DIY.`}
>
  <!-- City Hero Header -->
  <section class="gradient-hero text-white py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur border border-white/20 text-xs font-bold uppercase tracking-wider mb-4">
        <span>🛫 Aeroportul {airport.name} ({airport.code})</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-3">
        Vacanțe & Zboruri Ieftine din <span class="text-amber-300">{airport.city}</span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        Toate pachetele DIY (zbor dus-întors + cazare) calculate per persoană, cu plecare direct din {airport.city}. Fără comisioane de agenție.
      </p>

      <!-- Quick Switcher to Other Cities -->
      <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-slate-400 font-semibold">Alte orașe:</span>
        {otherAirports.map(a => {
          const s = a.city.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-');
          return (
            <a 
              href={`/plecari/${s}/`}
              class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-white font-medium transition-colors"
            >
              {a.city}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- City Deals Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          Oferte active din {airport.city}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Găsite și verificate recent de algoritmul nostru.
        </p>
      </div>

      <span class="px-3 py-1 rounded-full bg-slate-900 text-white text-xs font-bold">
        {cityDeals.length} oferte
      </span>
    </div>

    {cityDeals.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {cityDeals.map(deal => (
          <DealCard deal={deal} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 max-w-xl mx-auto">
        <div class="text-5xl mb-3">✈️</div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">Momentan nu sunt zboruri sub 50€ din {airport.city}</h3>
        <p class="text-sm text-slate-500 mb-6">
          Scanăm aeroportul {airport.name} de mai multe ori pe zi. Înscrie-te pe canalul de Telegram pentru a fi primul care află când apare o ofertă.
        </p>
        <a 
          href="/" 
          class="inline-block px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-rose-600 transition-colors"
        >
          &larr; Vezi toate ofertele din România
        </a>
      </div>
    )}
  </section>

  <!-- Kiwi Flights Partner Banner -->
  <KiwiBanner originCity={airport.city} subtitle={`Vrei să zbori din ${airport.city} spre o altă destinație? Caută toate rutele low-cost și legăturile disponibile din aeroportul ${airport.name} pe Kiwi.com.`} />

  <TelegramBanner />
</Layout>
