---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DealCard from '../components/DealCard.astro';
import CommunityBanner from '../components/CommunityBanner.astro';
import Newsletter from '../components/Newsletter.astro';
import AgodaBanner from '../components/AgodaBanner.astro';
import KiwiBanner from '../components/KiwiBanner.astro';
import deals from '../../data/deals.json';

// Sort deals with newest first
const sortedDeals = [...deals].sort((a, b) => 
  new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);

const originCounts: Record<string, number> = {};
deals.forEach(d => {
  const city = d.originCity || 'București';
  originCounts[city] = (originCounts[city] || 0) + 1;
});

const topOrigins = Object.entries(originCounts)
  .sort((a, b) => b[1] - a[1]);

// Search index for autocomplete predictions
const searchIndex: Array<{
  term: string;
  country: string;
  flag: string;
  category: string;
  minPrice: number;
  count: number;
}> = [];

const seenDestinations = new Set<string>();
deals.forEach(d => {
  const dest = (d.destination || '').split('(')[0].split('&')[0].trim();
  const country = d.country || '';
  const flag = d.flag || '✈️';
  const category = d.category || '';
  const price = d.priceTotalPerPerson || 0;
  const key = `${dest}__${country}`;

  if (!seenDestinations.has(key)) {
    seenDestinations.add(key);
    searchIndex.push({
      term: dest,
      country,
      flag,
      category,
      minPrice: price,
      count: 1
    });
  } else {
    const existing = searchIndex.find(x => x.term === dest && x.country === country);
    if (existing) {
      existing.count += 1;
      existing.minPrice = Math.min(existing.minPrice, price);
    }
  }
});

// Sort searchIndex by popularity
searchIndex.sort((a, b) => b.count - a.count || a.minPrice - b.minPrice);
---

<Layout 
  title="Ponturi Vacanțe Ieftine din România — Zbor + Cazare pe Cont Propriu"
  description="Călătorește pe cont propriu la jumătate de preț: oferte verificate de zbor low-cost + cazare, city break-uri europene, destinații exotice, schi, croaziere și cabane în România. Calculator live de buget pe fiecare ofertă."
  image="https://ponturivacante.ro/og-image.jpg"
>
  <!-- Hero Section with Filter Controls -->
  <Hero />

  <!-- Deals Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-16 relative z-20">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Cele mai noi oferte verificate</span>
          <span id="active-deals-badge" class="text-xs font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">
            {deals.length} oferte active
          </span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Prețuri calculate per persoană: bilet avion dus-întors (sau transport propriu cu mașina) + cazare verificată.
        </p>
      </div>

      <!-- Reset Filter Button (Hidden by default) -->
      <button 
        id="btn-reset-filters" 
        class="hidden text-xs font-bold text-rose-600 hover:text-rose-800 underline cursor-pointer text-left sm:text-right"
      >
        Resetează toate filtrele
      </button>
    </div>

    <!-- Quick Origin City Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-4 mb-2 no-scrollbar">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider whitespace-nowrap mr-1">Plecare:</span>
      <button type="button" class="city-pill active px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-xs font-bold shadow-sm transition-all whitespace-nowrap cursor-pointer hover:bg-rose-600" data-city="all">
        Toate ({deals.length})
      </button>
      {topOrigins.map(([city, count]) => (
        <button type="button" class="city-pill px-3.5 py-1.5 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-bold shadow-sm transition-all whitespace-nowrap cursor-pointer hover:bg-rose-50 hover:text-rose-600 hover:border-rose-300" data-city={city}>
          ✈️ {city} <span class="text-[10px] opacity-70">({count})</span>
        </button>
      ))}
    </div>

    <!-- Deals Grid -->
    <div id="deals-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {sortedDeals.map(deal => (
        <DealCard deal={deal} />
      ))}
    </div>

    <!-- Load More Button -->
    <div id="load-more-container" class="mt-12 text-center">
      <button 
        id="btn-load-more" 
        type="button" 
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-900 border-2 border-slate-200 hover:border-rose-300 hover:text-rose-600 font-extrabold text-sm sm:text-base shadow-sm hover:shadow-md transition-all cursor-pointer group"
      >
        <span id="load-more-text">Afișează încă 12 oferte</span>
        <span class="w-7 h-7 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-xs group-hover:translate-y-0.5 transition-transform font-black">
          ↓
        </span>
      </button>
      <div class="mt-3">
        <span id="load-more-counter" class="text-xs font-semibold text-slate-400">
          Afișezi 12 din {deals.length} oferte
        </span>
      </div>
    </div>

    <!-- No Deals Found State (Hidden by default) -->
    <div id="no-deals-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8">
      <div class="text-5xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Nu am găsit oferte pentru această combinație</h3>
      <p class="text-sm text-slate-500 mb-4">Încearcă să alegi alt oraș de plecare sau să mărești bugetul.</p>
      <button 
        id="btn-reset-state" 
        class="px-5 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-rose-600 transition-colors"
      >
        Afișează toate ofertele
      </button>
    </div>

    <!-- Feature Highlight: Calculator de Buget -->
    <div class="mt-12 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 rounded-3xl p-6 sm:p-8 text-white border border-slate-800 shadow-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-10 -top-10 w-60 h-60 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-xl text-center md:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-black uppercase tracking-wider mb-3 border border-amber-300/30">
            <span>🧮 TRANSPARENȚĂ 100%</span>
            <span>•</span>
            <span>CALCULATOR LIVE</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black tracking-tight mb-2">
            Cât te costă cu adevărat o vacanță pe cont propriu?
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Fără costuri ascunse. În fiecare ofertă ai un <strong>calculator interactiv de buget</strong>: personalizezi numărul de persoane (1, 2, 4), adaugi bagajul de cală, mesele zilnice și transferul de la aeroport, cu calcul instant în Euro și Lei.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
          <div class="flex items-center gap-2 text-xs font-bold text-amber-300 bg-slate-800/90 px-4 py-2.5 rounded-xl border border-slate-700 shadow-md">
            <span>👥 1, 2 sau 4 Călători</span>
            <span>&bull;</span>
            <span>🧳 Cală</span>
            <span>&bull;</span>
            <span>🍽️ Mese</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Agoda & Kiwi Official Partner Banners -->
  <AgodaBanner />
  <KiwiBanner />

  <!-- Community Callout: Telegram + WhatsApp -->
  <CommunityBanner />

  <!-- Email Newsletter Subscription -->
  <Newsletter />

  <!-- Client-side filter script with live predictions -->
  <script is:inline define:vars={{ searchIndex }}>
    const filterSearch = document.getElementById('filter-search');
    const searchContainer = document.getElementById('search-container');
    const autocompleteBox = document.getElementById('search-autocomplete');
    const btnClearSearch = document.getElementById('btn-clear-search');
    const filterOrigin = document.getElementById('filter-origin');
    const filterBudget = document.getElementById('filter-budget');
    const filterCategory = document.getElementById('filter-category');
    const btnReset = document.getElementById('btn-reset-filters');
    const btnResetState = document.getElementById('btn-reset-state');
    const cards = Array.from(document.querySelectorAll('.deal-card'));
    const noDealsState = document.getElementById('no-deals-state');
    const badge = document.getElementById('active-deals-badge');
    const transportTabs = document.querySelectorAll('.transport-tab');

    // Load More Elements
    const loadMoreContainer = document.getElementById('load-more-container');
    const btnLoadMore = document.getElementById('btn-load-more');
    const loadMoreText = document.getElementById('load-more-text');
    const loadMoreCounter = document.getElementById('load-more-counter');

    const PAGE_SIZE = 12;
    let visibleLimit = PAGE_SIZE;
    let currentTransport = 'all';

    function updateOriginOptions(transportMode) {
      if (!filterOrigin) return;
      const originLabel = document.getElementById('filter-origin-label');
      const isCar = (transportMode === 'car');
      
      if (originLabel) {
        originLabel.innerHTML = isCar ? '🚗 Oraș de plecare' : '🛫 Oraș de plecare';
      }

      const options = filterOrigin.querySelectorAll('option');
      options.forEach(opt => {
        if (opt.value === 'all') {
          opt.textContent = 'Toate orașele din România';
          return;
        }
        const city = opt.dataset.city || opt.value;
        const code = opt.dataset.code;
        if (isCar || !code) {
          opt.textContent = city;
        } else {
          opt.textContent = `${city} (${code})`;
        }
      });
    }

    function setTransport(val) {
      currentTransport = val;
      transportTabs.forEach(tab => {
        const isMatch = (tab.dataset.transport === val);
        if (isMatch) {
          tab.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-sm', 'font-bold');
          tab.classList.remove('text-slate-600', 'font-medium', 'hover:bg-white/60');
        } else {
          tab.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-sm', 'font-bold');
          tab.classList.add('text-slate-600', 'font-medium', 'hover:bg-white/60');
        }
      });
      updateOriginOptions(val);
      visibleLimit = PAGE_SIZE;
      applyFilters();
    }

    transportTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        setTransport(tab.dataset.transport || 'all');
      });
    });

    function applyFilters() {
      const query = (filterSearch?.value || '').trim().toLowerCase();
      const selectedOrigin = filterOrigin?.value || 'all';
      const selectedBudget = filterBudget?.value || 'all';
      const selectedCategory = filterCategory?.value || 'all';

      // 1. Filter matching cards
      const matchingCards = [];
      const nonMatchingCards = [];

      cards.forEach(card => {
        const origin = card.dataset.origin;
        const category = card.dataset.category;
        const price = parseFloat(card.dataset.price);
        const cardTransport = card.dataset.transport || 'flight';
        const cardText = card.innerText.toLowerCase();

        const matchSearch = (!query || cardText.includes(query));
        const matchOrigin = (selectedOrigin === 'all' || origin === selectedOrigin);
        
        let matchCategory = (selectedCategory === 'all');
        if (!matchCategory) {
          const sel = selectedCategory.toLowerCase().trim();
          const cardCat = (card.dataset.category || '').toLowerCase();
          const cardCats = (card.dataset.categories || '').toLowerCase();
          const cardTitle = cardText;

          if (sel.includes('craciun') || sel.includes('crăciun')) {
            matchCategory = cardCats.includes('craciun') || cardTitle.includes('craciun') || cardTitle.includes('crăciun');
          } else if (sel.includes('1 decembrie')) {
            matchCategory = cardCats.includes('1 decembrie') || cardTitle.includes('1 decembrie');
          } else if (sel.includes('revelion')) {
            matchCategory = cardCats.includes('revelion') || cardTitle.includes('revelion');
          } else if (sel.includes('schi') || sel.includes('ski')) {
            matchCategory = cardCats.includes('schi') || cardCats.includes('ski');
          } else if (sel.includes('exotic')) {
            matchCategory = cardCats.includes('exotic') || cardCats.includes('soare de iarnă');
          } else if (sel.includes('city')) {
            matchCategory = cardCats.includes('city break');
          } else if (sel.includes('weekend')) {
            matchCategory = cardCats.includes('weekend');
          } else {
            matchCategory = cardCat.includes(sel) || cardCats.includes(sel);
          }
        }

        const matchBudget = (selectedBudget === 'all' || price <= parseFloat(selectedBudget));
        const matchTransport = (currentTransport === 'all' || cardTransport === currentTransport);

        if (matchSearch && matchOrigin && matchCategory && matchBudget && matchTransport) {
          matchingCards.push(card);
        } else {
          nonMatchingCards.push(card);
        }
      });

      // Always hide non-matching
      nonMatchingCards.forEach(c => c.classList.add('hidden'));

      // 2. Paginate matching cards
      const totalMatches = matchingCards.length;
      const countToShow = Math.min(visibleLimit, totalMatches);

      matchingCards.forEach((card, index) => {
        if (index < countToShow) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Update badge count
      if (badge) {
        if (totalMatches === countToShow) {
          badge.innerText = `${totalMatches} oferte afișate`;
        } else {
          badge.innerText = `${countToShow} din ${totalMatches} oferte afișate`;
        }
      }

      // 3. Update Load More button state
      if (loadMoreContainer) {
        if (countToShow < totalMatches) {
          loadMoreContainer.classList.remove('hidden');
          const remaining = totalMatches - countToShow;
          const nextBatch = Math.min(PAGE_SIZE, remaining);
          if (loadMoreText) {
            loadMoreText.innerText = `Afișează încă ${nextBatch} oferte`;
          }
          if (loadMoreCounter) {
            loadMoreCounter.innerText = `Afișezi ${countToShow} din ${totalMatches} oferte disponibile (au mai rămas ${remaining})`;
          }
        } else {
          loadMoreContainer.classList.add('hidden');
        }
      }

      // Show / hide empty state
      if (totalMatches === 0) {
        if (noDealsState) noDealsState.classList.remove('hidden');
      } else {
        if (noDealsState) noDealsState.classList.add('hidden');
      }

      // Show reset button if any filter is active
      const isFiltered = (query !== '' || selectedOrigin !== 'all' || selectedBudget !== 'all' || selectedCategory !== 'all' || currentTransport !== 'all');
      if (btnReset) {
        if (isFiltered) {
          btnReset.classList.remove('hidden');
        } else {
          btnReset.classList.add('hidden');
        }
      }
    }

    // Handle "Load More" click
    if (btnLoadMore) {
      btnLoadMore.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        applyFilters();
      });
    }

    function resetFilters() {
      if (filterSearch) filterSearch.value = '';
      if (filterOrigin) filterOrigin.value = 'all';
      if (filterBudget) filterBudget.value = 'all';
      if (filterCategory) filterCategory.value = 'all';
      visibleLimit = PAGE_SIZE;
      setTransport('all');
      updateCityPills('all');
    }

    // City pills selector sync
    const cityPills = document.querySelectorAll('.city-pill');
    function updateCityPills(selectedCity) {
      cityPills.forEach(p => {
        const match = (p.dataset.city === selectedCity);
        if (match) {
          p.classList.add('bg-slate-900', 'text-white');
          p.classList.remove('bg-white', 'text-slate-700');
        } else {
          p.classList.remove('bg-slate-900', 'text-white');
          p.classList.add('bg-white', 'text-slate-700');
        }
      });
    }

    cityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const city = pill.dataset.city || 'all';
        if (filterOrigin) {
          filterOrigin.value = city;
        }
        updateCityPills(city);
        applyFilters();
      });
    });

    // Trending search chips from hero
    const heroChips = document.querySelectorAll('.hero-chip');
    heroChips.forEach(chip => {
      chip.addEventListener('click', () => {
        if (chip.dataset.budget && filterBudget) {
          filterBudget.value = chip.dataset.budget;
        }
        if (chip.dataset.category && filterCategory) {
          filterCategory.value = chip.dataset.category;
        }
        if (chip.dataset.query && filterSearch) {
          filterSearch.value = chip.dataset.query;
        }
        visibleLimit = PAGE_SIZE;
        applyFilters();
        const dealsGrid = document.getElementById('deals-grid');
        if (dealsGrid) {
          dealsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Top festive badges click listener on homepage
    const topBadges = document.querySelectorAll('.top-festive-badge');
    topBadges.forEach(b => {
      b.addEventListener('click', (e) => {
        if (!e.ctrlKey && !e.metaKey && !e.shiftKey && e.button === 0) {
          e.preventDefault();
          const cat = b.dataset.filterCategory;
          if (cat && filterCategory) {
            filterCategory.value = cat;
            visibleLimit = PAGE_SIZE;
            applyFilters();
            const dealsGrid = document.getElementById('deals-grid');
            if (dealsGrid) {
              dealsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });
    });

    // --- 🔮 AUTOCOMPLETE PREDICTIE CĂUTARE ---
    let selectedSuggestionIndex = -1;
    let currentMatches = [];

    function normalizeText(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function hideAutocomplete() {
      if (autocompleteBox) {
        autocompleteBox.classList.add('hidden');
        autocompleteBox.innerHTML = '';
      }
      selectedSuggestionIndex = -1;
      currentMatches = [];
    }

    function selectSuggestion(item) {
      if (!filterSearch || !item) return;
      filterSearch.value = item.term;
      hideAutocomplete();
      updateClearButton();
      visibleLimit = PAGE_SIZE;
      applyFilters();

      const dealsGrid = document.getElementById('deals-grid');
      if (dealsGrid) {
        dealsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function highlightMatch(text, query) {
      if (!query) return text;
      const normText = normalizeText(text);
      const normQuery = normalizeText(query);
      const idx = normText.indexOf(normQuery);
      if (idx === -1) return text;
      const before = text.slice(0, idx);
      const match = text.slice(idx, idx + query.length);
      const after = text.slice(idx + query.length);
      return `${before}<mark class="bg-rose-100 text-rose-700 font-black rounded px-0.5">${match}</mark>${after}`;
    }

    function renderAutocomplete(query) {
      if (!autocompleteBox || !query || query.length < 1) {
        hideAutocomplete();
        return;
      }

      const q = normalizeText(query);

      // Find matches in searchIndex
      const matches = searchIndex.filter(item => {
        const normTerm = normalizeText(item.term);
        const normCountry = normalizeText(item.country);
        const normCat = normalizeText(item.category);
        return normTerm.includes(q) || normCountry.includes(q) || normCat.includes(q);
      });

      // Sort: starts with query first, then by popularity/price
      matches.sort((a, b) => {
        const aStarts = normalizeText(a.term).startsWith(q) || normalizeText(a.country).startsWith(q);
        const bStarts = normalizeText(b.term).startsWith(q) || normalizeText(b.country).startsWith(q);
        if (aStarts && !bStarts) return -1;
        if (!aStarts && bStarts) return 1;
        return (b.count - a.count) || (a.minPrice - b.minPrice);
      });

      currentMatches = matches.slice(0, 6); // Max 6 suggestions

      if (currentMatches.length === 0) {
        hideAutocomplete();
        return;
      }

      selectedSuggestionIndex = -1;

      let html = '<div class="px-3 py-1.5 bg-slate-50 text-[10px] font-black uppercase tracking-wider text-slate-400 flex items-center justify-between"><span>Destinații Sugerate</span><span>Apasă Enter sau Click</span></div>';

      currentMatches.forEach((item, index) => {
        const termHighlighted = highlightMatch(item.term, query);
        const countryHighlighted = highlightMatch(item.country, query);

        html += `
          <button 
            type="button" 
            class="autocomplete-item w-full text-left px-3.5 py-2.5 hover:bg-rose-50/70 focus:bg-rose-50 flex items-center justify-between gap-3 transition-colors cursor-pointer group"
            data-index="${index}"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="text-xl shrink-0">${item.flag}</span>
              <div class="min-w-0 truncate">
                <div class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-rose-600 truncate">
                  ${termHighlighted}
                  <span class="text-slate-400 font-normal text-xs ml-1">(${countryHighlighted})</span>
                </div>
                <div class="text-[10px] text-slate-400 flex items-center gap-1.5">
                  <span class="font-semibold text-slate-600">${item.category}</span>
                  <span>&bull;</span>
                  <span>${item.count} ${item.count === 1 ? 'ofertă verificată' : 'oferte verificate'}</span>
                </div>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="text-xs font-black text-rose-600 block">de la ${item.minPrice}&nbsp;€</span>
              <span class="text-[10px] text-slate-400 font-medium">/ pers</span>
            </div>
          </button>
        `;
      });

      autocompleteBox.innerHTML = html;
      autocompleteBox.classList.remove('hidden');

      // Bind click on items
      const itemButtons = autocompleteBox.querySelectorAll('.autocomplete-item');
      itemButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.dataset.index, 10);
          selectSuggestion(currentMatches[idx]);
        });
      });
    }

    function updateClearButton() {
      if (!btnClearSearch || !filterSearch) return;
      if (filterSearch.value.trim().length > 0) {
        btnClearSearch.classList.remove('hidden');
      } else {
        btnClearSearch.classList.add('hidden');
      }
    }

    if (filterSearch) {
      filterSearch.addEventListener('input', () => {
        visibleLimit = PAGE_SIZE;
        updateClearButton();
        applyFilters();
        renderAutocomplete(filterSearch.value.trim());
      });

      filterSearch.addEventListener('focus', () => {
        if (filterSearch.value.trim().length >= 1) {
          renderAutocomplete(filterSearch.value.trim());
        }
      });

      // Keyboard navigation in autocomplete
      filterSearch.addEventListener('keydown', (e) => {
        if (!autocompleteBox || autocompleteBox.classList.contains('hidden') || currentMatches.length === 0) {
          return;
        }

        const items = autocompleteBox.querySelectorAll('.autocomplete-item');

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedSuggestionIndex = (selectedSuggestionIndex + 1) % currentMatches.length;
          items.forEach((it, idx) => {
            if (idx === selectedSuggestionIndex) {
              it.classList.add('bg-rose-50', 'ring-2', 'ring-rose-400');
              it.scrollIntoView({ block: 'nearest' });
            } else {
              it.classList.remove('bg-rose-50', 'ring-2', 'ring-rose-400');
            }
          });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedSuggestionIndex = (selectedSuggestionIndex - 1 + currentMatches.length) % currentMatches.length;
          items.forEach((it, idx) => {
            if (idx === selectedSuggestionIndex) {
              it.classList.add('bg-rose-50', 'ring-2', 'ring-rose-400');
              it.scrollIntoView({ block: 'nearest' });
            } else {
              it.classList.remove('bg-rose-50', 'ring-2', 'ring-rose-400');
            }
          });
        } else if (e.key === 'Enter') {
          if (selectedSuggestionIndex >= 0 && selectedSuggestionIndex < currentMatches.length) {
            e.preventDefault();
            selectSuggestion(currentMatches[selectedSuggestionIndex]);
          } else {
            hideAutocomplete();
          }
        } else if (e.key === 'Escape') {
          hideAutocomplete();
        }
      });
    }

    if (btnClearSearch) {
      btnClearSearch.addEventListener('click', () => {
        if (filterSearch) {
          filterSearch.value = '';
          filterSearch.focus();
        }
        updateClearButton();
        hideAutocomplete();
        visibleLimit = PAGE_SIZE;
        applyFilters();
      });
    }

    // Close autocomplete on click outside
    document.addEventListener('click', (e) => {
      if (searchContainer && !searchContainer.contains(e.target)) {
        hideAutocomplete();
      }
    });
    if (filterOrigin) {
      filterOrigin.addEventListener('change', () => {
        updateCityPills(filterOrigin.value);
        visibleLimit = PAGE_SIZE;
        applyFilters();
      });
    }
    if (filterBudget) filterBudget.addEventListener('change', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
    if (filterCategory) filterCategory.addEventListener('change', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
    if (btnReset) btnReset.addEventListener('click', resetFilters);
    if (btnResetState) btnResetState.addEventListener('click', resetFilters);

    // Initial page load limit to 12 deals
    applyFilters();
  </script>
</Layout>
