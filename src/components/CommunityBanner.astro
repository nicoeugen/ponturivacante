---
---

<aside class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Card Telegram -->
    <div class="relative bg-gradient-to-br from-sky-600 to-sky-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl overflow-hidden flex flex-col justify-between">
      <div class="relative z-10 mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur text-xs font-bold uppercase tracking-wider mb-3">
          ⚡ Alerte Instantanee
        </div>
        <h3 class="text-2xl font-black mb-2 flex items-center gap-2">
          <span>Canal de Telegram</span>
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
        </h3>
        <p class="text-sky-100 text-sm leading-relaxed">
          Biletele de avion sub 30€ se epuizează în 4-6 ore. Pe Telegram primești notificare direct pe ecran în secunda în care apare o eroare de tarif sau un chilipir.
        </p>
      </div>

      <div class="relative z-10">
        <a 
          href="https://t.me" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-2xl bg-white hover:bg-slate-100 text-sky-600 font-extrabold text-sm transition-all shadow-md"
        >
          <span>Intră pe Telegram</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Card WhatsApp -->
    <div class="relative bg-gradient-to-br from-emerald-600 to-teal-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl overflow-hidden flex flex-col justify-between">
      <div class="relative z-10 mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur text-xs font-bold uppercase tracking-wider mb-3">
          💬 Canal Oficial
        </div>
        <h3 class="text-2xl font-black mb-2 flex items-center gap-2">
          <span>Canal de WhatsApp</span>
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </h3>
        <p class="text-emerald-100 text-sm leading-relaxed">
          Dacă folosești WhatsApp mai des, urmărește canalul nostru dedicat. Postăm doar cele mai bune 2 oferte ale zilei, direct pe ecranul tău, fără mesaje inutile.
        </p>
      </div>

      <div class="relative z-10">
        <a 
          href="https://whatsapp.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-2xl bg-white hover:bg-slate-100 text-emerald-700 font-extrabold text-sm transition-all shadow-md"
        >
          <span>Urmărește pe WhatsApp</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</aside>
