---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Călătorește pe cont propriu la jumătate de preț: oferte verificate de zbor low-cost + cazare, city break-uri europene, destinații exotice, schi, croaziere și cabane în România. Calculator live de buget pe fiecare ofertă.",
  image = "https://ponturivacante.ro/og-image.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ponturivacante.ro');

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PonturiVacanțe",
  "url": "https://ponturivacante.ro",
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ponturivacante.ro/?search={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#e11d48" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} — PonturiVacanțe</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="PonturiVacanțe RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : `https://ponturivacante.ro${image}`} />
    <meta property="og:image:secure_url" content={image.startsWith('http') ? image : `https://ponturivacante.ro${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PonturiVacanțe — Călătorește pe cont propriu la jumătate de preț" />
    <meta property="og:site_name" content="PonturiVacanțe" />
    <meta property="og:locale" content="ro_RO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : `https://ponturivacante.ro${image}`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
