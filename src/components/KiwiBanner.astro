---
interface Props {
  originCity?: string;
  destination?: string;
  subtitle?: string;
}

const { originCity, destination, subtitle } = Astro.props;

// Build target Kiwi search URL
let targetUrl = 'https://www.kiwi.com/ro/';
if (originCity && destination) {
  targetUrl = `https://www.kiwi.com/ro/search/tiles/${encodeURIComponent(originCity.toLowerCase())}/${encodeURIComponent(destination.toLowerCase())}`;
} else if (originCity) {
  targetUrl = `https://www.kiwi.com/ro/search/tiles/${encodeURIComponent(originCity.toLowerCase())}/all`;
}

const affUrl = `/go/flight/?url=${encodeURIComponent(targetUrl)}&provider=kiwi`;
---

<aside class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-12">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-950 via-teal-950 to-slate-950 text-white p-6 sm:p-10 shadow-2xl border border-emerald-500/30">
    <!-- Decorative background glow -->
    <div class="absolute -right-16 -top-16 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-black tracking-wider uppercase">
          <span>✈️ Partener Oficial Zboruri Ieftine</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Virtual Interlining™</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
          {originCity ? `Cauți zboruri ieftine cu plecare din ${originCity}?` : 'Cauți doar bilete de avion sau vrei să combini companii low-cost?'}
        </h3>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {subtitle || 'Kiwi.com combină zboruri de la companii aeriene diferite (Wizz Air, Ryanair, EasyJet, HiSky, Lufthansa) pe itinerarii unice cu escale protejate, permițându-ți să ajungi oriunde în lume la cel mai mic preț posibil.'}
        </p>

        <!-- Trust Badges -->
        <div class="flex flex-wrap items-center gap-4 pt-1 text-xs text-emerald-200/90 font-medium">
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> Conexiuni Low-Cost Inteligente
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> Protecție Garanția Kiwi
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> Căutare oriunde (Nomad)
          </span>
        </div>
      </div>

      <div class="shrink-0 w-full lg:w-auto">
        <a 
          href={affUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full lg:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-black text-sm transition-all shadow-lg shadow-emerald-500/25 hover:scale-105 active:scale-95 whitespace-nowrap cursor-pointer"
        >
          <span>{originCity ? `Caută zboruri din ${originCity} pe Kiwi` : 'Caută Zboruri pe Kiwi.com'}</span>
          <span>&rarr;</span>
        </a>
        <span class="block text-center lg:text-right text-[11px] text-slate-400 mt-2 font-medium">
          Partener oficial verificat PonturiVacanțe
        </span>
      </div>
    </div>
  </div>
</aside>
