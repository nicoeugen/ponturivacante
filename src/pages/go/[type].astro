---
export function getStaticPaths() {
  return [
    { params: { type: 'flight' } },
    { params: { type: 'hotel' } },
  ];
}
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Redirecționare securizată către partener...</title>
  <script is:inline>
    (function() {
      const params = new URLSearchParams(window.location.search);
      const targetUrl = params.get('url');
      const provider = params.get('provider') || 'booking';
      const isFlight = window.location.pathname.includes('/flight');
      
      // Identificatori oficiali de partener & afiliere
      const CONFIG = {
        TRAVELPAYOUTS_MARKER: '801687',
        BOOKING_AID: '', // Se completează cu ID-ul oficial de la Booking.com Partner
        AGODA_CID: '1980047', // Activ & Verificat PonturiVacante
        TWO_PERFORMANT_AFF_CODE: '', // Codul tău de afiliat 2Performant
        DIRECTBOOKING_CAMPAIGN_ID: '', // ID campanie DirectBooking din 2Performant
        VOLA_CAMPAIGN_ID: '', // ID campanie Vola.ro din 2Performant
        HOSTELWORLD_AID: ''
      };

      if (targetUrl) {
        try {
          // Dacă URL-ul este deja un link de tracking 2Performant generat
          if (targetUrl.includes('event.2performant.com')) {
            window.location.replace(targetUrl);
            return;
          }

          const u = new URL(targetUrl);
          const host = u.hostname.toLowerCase();

          // Rutare automată prin 2Performant pentru partenerii din România
          if (CONFIG.TWO_PERFORMANT_AFF_CODE) {
            if (host.includes('directbooking.ro') || provider === 'directbooking') {
              const tpUrl = `https://event.2performant.com/events/click?ad_type=quicklink&aff_code=${CONFIG.TWO_PERFORMANT_AFF_CODE}&unique=${CONFIG.DIRECTBOOKING_CAMPAIGN_ID || ''}&redirect_to=${encodeURIComponent(targetUrl)}`;
              window.location.replace(tpUrl);
              return;
            }
            if (host.includes('vola.ro') || provider === 'vola') {
              const tpUrl = `https://event.2performant.com/events/click?ad_type=quicklink&aff_code=${CONFIG.TWO_PERFORMANT_AFF_CODE}&unique=${CONFIG.VOLA_CAMPAIGN_ID || ''}&redirect_to=${encodeURIComponent(targetUrl)}`;
              window.location.replace(tpUrl);
              return;
            }
          }

          if (isFlight) {
            const isAirline = host.includes('wizzair.com') || 
                              host.includes('ryanair.com') || 
                              host.includes('austrian.com') || 
                              host.includes('hisky.aero') || 
                              host.includes('lufthansa.com') || 
                              host.includes('tarom.ro');

            // Nu injectăm parametri străini în routerul SPA al companiilor aeriene (Wizz, Ryanair etc.)
            // deoarece parametrii necunoscuți determină routerul să redirecționeze pe homepage.
            if (!isAirline) {
              if (CONFIG.TRAVELPAYOUTS_MARKER) {
                u.searchParams.set('marker', CONFIG.TRAVELPAYOUTS_MARKER);
              }
              if (provider === 'kiwi' || host.includes('kiwi.com')) {
                u.searchParams.set('affilid', 'travelpayouts');
                u.searchParams.set('marker', CONFIG.TRAVELPAYOUTS_MARKER);
              }
              if (provider === 'aviasales' || host.includes('aviasales.com')) {
                u.searchParams.set('marker', CONFIG.TRAVELPAYOUTS_MARKER);
              }
              u.searchParams.set('utm_source', 'ponturivacante');
              u.searchParams.set('utm_medium', 'affiliate');
            }
          } else {
            if (provider === 'agoda' || host.includes('agoda.com')) {
              if (CONFIG.AGODA_CID) u.searchParams.set('cid', CONFIG.AGODA_CID);
              if (CONFIG.TRAVELPAYOUTS_MARKER) u.searchParams.set('marker', CONFIG.TRAVELPAYOUTS_MARKER);
              u.searchParams.set('utm_source', 'ponturivacante');
            } else if (provider === 'hostelworld' || host.includes('hostelworld.com')) {
              if (CONFIG.HOSTELWORLD_AID) u.searchParams.set('affiliate', CONFIG.HOSTELWORLD_AID);
              u.searchParams.set('utm_source', 'ponturivacante');
            } else if (host.includes('booking.com')) {
              // Booking.com: merge direct pe pagina hotelului selectat
              if (CONFIG.BOOKING_AID) {
                u.searchParams.set('aid', CONFIG.BOOKING_AID);
              }
            } else {
              u.searchParams.set('utm_source', 'ponturivacante');
            }
          }

          window.location.replace(u.toString());
        } catch(e) {
          window.location.replace(targetUrl);
        }
      } else {
        window.location.replace('/');
      }
    })();
  </script>
</head>
<body style="font-family: system-ui, -apple-system, sans-serif; background: #0f172a; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; text-align: center;">
  <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); padding: 32px 40px; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); max-width: 420px;">
    <div style="font-size: 48px; margin-bottom: 16px; animation: bounce 1s infinite;">✈️</div>
    <h2 style="margin: 0 0 8px; font-size: 22px; font-weight: 800;">Te redirecționăm către partener...</h2>
    <p style="margin: 0 0 16px; font-size: 13px; color: #94a3b8; line-height: 1.5;">
      Verificăm disponibilitatea tarifelor oficiale în timp real. Vei ajunge direct pe pagina de rezervare securizată.
    </p>
    <div style="font-size: 11px; color: #64748b;">
      Dacă nu ești redirecționat automat în 2 secunde, <a id="fallback-link" style="color: #38bdf8; text-decoration: underline;" href="#">apasă aici</a>.
    </div>
  </div>
  <script is:inline>
    const fallbackUrl = new URLSearchParams(window.location.search).get('url');
    if (fallbackUrl) {
      document.getElementById('fallback-link').setAttribute('href', fallbackUrl);
    }
  </script>
</body>
</html>
