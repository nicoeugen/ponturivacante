---
interface Props {
  cruise: {
    id: string;
    slug: string;
    title: string;
    destination: string;
    cruiseLine: string;
    shipName: string;
    boardingPort: string;
    originCity: string;
    dates: string;
    nights: number;
    itinerary: string[];
    image: string;
    priceTotalPerPerson: number;
    flightPrice: number;
    cruisePrice: number;
    badge: string;
    flight: {
      airline: string;
      route: string;
    };
    cruiseDetails: {
      mealPlan: string;
    };
  };
}

const { cruise } = Astro.props;
---

<article 
  class="cruise-card group bg-white rounded-3xl overflow-hidden border border-slate-200 card-shadow hover:-translate-y-1 hover:shadow-2xl transition-all duration-300 flex flex-col justify-between"
  data-destination={cruise.destination}
  data-cruiseline={cruise.cruiseLine}
  data-price={cruise.priceTotalPerPerson}
  data-title={cruise.title.toLowerCase()}
  data-ship={cruise.shipName.toLowerCase()}
  data-port={cruise.boardingPort.toLowerCase()}
>
  <div>
    <!-- Cover Image with Badges -->
    <div class="relative h-56 sm:h-60 overflow-hidden">
      <img 
        src={cruise.image} 
        alt={cruise.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>

      <!-- Badges -->
      <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
        <span class="px-2.5 py-1 rounded-full bg-indigo-600 text-white text-xs font-black shadow-md">
          {cruise.badge}
        </span>
        <span class="px-2.5 py-1 rounded-full bg-slate-900/80 backdrop-blur text-white text-xs font-semibold">
          {cruise.nights} nopți pe mare
        </span>
      </div>

      <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-amber-400 text-slate-950 text-xs font-black shadow">
        Pensiune Completă
      </div>

      <!-- Bottom overlay -->
      <div class="absolute bottom-3 left-3 right-3 text-white">
        <div class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
          <span>Îmbarcare: {cruise.boardingPort}</span>
          <span>&bull;</span>
          <span>Zbor din {cruise.originCity}</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-white leading-tight">
          {cruise.shipName} &bull; {cruise.cruiseLine}
        </h3>
      </div>
    </div>

    <!-- Content & Itinerary Preview -->
    <div class="p-5">
      <h4 class="font-bold text-slate-900 text-base mb-3 leading-snug line-clamp-2">
        {cruise.title}
      </h4>

      <!-- Porturi / Itinerar scurt -->
      <div class="bg-indigo-50/60 rounded-2xl p-3.5 border border-indigo-100 text-xs text-slate-700 mb-4 space-y-1.5">
        <div class="font-extrabold text-indigo-900 flex items-center gap-1.5">
          <span>🗺️ Itinerar port cu port:</span>
        </div>
        <div class="text-slate-600 line-clamp-2 font-medium">
          {cruise.itinerary.join(' → ')}
        </div>
      </div>

      <!-- Breakdown: Zbor + Croazieră -->
      <div class="space-y-1.5 text-xs text-slate-600 border-t border-slate-100 pt-3">
        <div class="flex items-center justify-between gap-2">
          <span class="truncate">✈️ Zbor dus-întors ({cruise.flight.airline}):</span>
          <span class="font-bold text-slate-900 whitespace-nowrap flex-shrink-0 ml-2">{cruise.flightPrice}&nbsp;€ <span class="text-[10px] text-slate-400 font-normal">/pers</span></span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="truncate">🚢 Cazare {cruise.nights} nopți + Mese gourmet:</span>
          <span class="font-bold text-slate-900 whitespace-nowrap flex-shrink-0 ml-2">{cruise.cruisePrice}&nbsp;€ <span class="text-[10px] text-slate-400 font-normal">/pers</span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA & Price -->
  <div class="px-5 pb-5 pt-0 border-t border-slate-100 mt-auto">
    <div class="pt-4 flex items-center justify-between gap-3">
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Pachet complet:</div>
        <div class="text-2xl font-black text-indigo-600 leading-none whitespace-nowrap">
          {cruise.priceTotalPerPerson}&nbsp;€
          <span class="text-xs font-medium text-slate-500">/ pers</span>
        </div>
      </div>

      <a 
        href={`/croaziere/${cruise.slug}`}
        class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white font-bold text-xs transition-colors shadow-sm"
      >
        Vezi Croaziera &rarr;
      </a>
    </div>
  </div>
</article>
