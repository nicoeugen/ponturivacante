---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-16">
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 rounded-3xl p-8 sm:p-12 text-white border border-slate-800 shadow-2xl relative overflow-hidden">
    <!-- Decorative background circle -->
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-rose-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-2xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs font-bold uppercase tracking-wider mb-4">
        💌 Newsletter Săptămânal Gratuit
      </div>

      <h3 class="text-2xl sm:text-4xl font-black tracking-tight mb-3">
        Cele mai tari chilipiruri, direct în inbox-ul tău
      </h3>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
        În fiecare joi dimineață trimitem abonaților noștri un rezumat cu <strong>Top 5 vacanțe de weekend sub 100€</strong> cu plecare din România. Fără spam, doar oferte reale.
      </p>

      <!-- Formular de Abonare -->
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input 
          type="email" 
          id="newsletter-email" 
          required 
          placeholder="Adresa ta de email..." 
          class="flex-grow px-4 py-3.5 rounded-2xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all"
        />
        <button 
          type="submit" 
          id="newsletter-btn"
          class="px-6 py-3.5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-sm transition-all shadow-lg hover:shadow-rose-600/30 cursor-pointer flex-shrink-0"
        >
          Mă abonez &rarr;
        </button>
      </form>

      <!-- Success message -->
      <div id="newsletter-success" class="hidden mt-4 p-4 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-200 text-sm font-semibold">
        🎉 Felicitări! Te-ai abonat cu succes. Pregătește-te de vacanță!
      </div>

      <p class="text-[11px] text-slate-500 mt-4">
        Te poți dezabona oricând cu un singur click. Datele tale sunt protejate conform GDPR.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('newsletter-form');
  const emailInput = document.getElementById('newsletter-email');
  const successBox = document.getElementById('newsletter-success');
  const btn = document.getElementById('newsletter-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = emailInput?.value;
    if (email) {
      btn.disabled = true;
      btn.innerText = 'Se trimite...';

      // Salvare locală (sau webhook extern)
      try {
        const subs = JSON.parse(localStorage.getItem('diy_subscribers') || '[]');
        subs.push({ email, date: new Date().toISOString() });
        localStorage.setItem('diy_subscribers', JSON.stringify(subs));
      } catch (err) {}

      setTimeout(() => {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      }, 600);
    }
  });
</script>
