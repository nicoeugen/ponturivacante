  <!-- Client-side script for Duo vs Solo toggle -->



  <script is:inline define:vars={{ duoPrice: deal.priceTotalPerPerson, soloPrice, duoHotel: deal.hotel.pricePerPerson, soloHotel: deal.hotel.priceTotal }}>



    const btnDuo = document.getElementById('toggle-duo');



    const btnCopy = document.getElementById('btn-copy-offer-link');
    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        const url = btnCopy.dataset.url || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          const icon = document.getElementById('copy-icon');
          const text = document.getElementById('copy-text');
          if (icon) icon.textContent = '✓';
          if (text) text.textContent = 'Link copiat!';
          setTimeout(() => {
            if (icon) icon.textContent = '🔗';
            if (text) text.textContent = 'Copiază Linkul Ofertei';
          }, 2500);
        } catch(e) {
          prompt('Copiază linkul:', url);
        }
      });
    }

    const btnSolo = document.getElementById('toggle-solo');



    const badgePrice = document.getElementById('badge-total-price');



    const badgeLabel = document.getElementById('badge-total-label');



    const summaryHotel = document.getElementById('summary-hotel-price');



    const summaryTotal = document.getElementById('summary-total-price');



    const summarySub = document.getElementById('summary-total-sub');



    btnDuo?.addEventListener('click', () => {



      btnDuo.className = 'px-4 py-2 rounded-lg bg-white text-slate-900 shadow-sm transition-all cursor-pointer';



      btnSolo.className = 'px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer';



      badgePrice.innerText = `${duoPrice} €`;



      badgeLabel.innerText = '/ persoană';



      summaryHotel.innerHTML = `${duoHotel} € <span class="text-xs font-normal">/pers</span>`;



      summaryTotal.innerText = `${duoPrice} €`;



      summarySub.innerText = 'zbor + cazare / pers';



    });



    btnSolo?.addEventListener('click', () => {



      btnSolo.className = 'px-4 py-2 rounded-lg bg-white text-slate-900 shadow-sm transition-all cursor-pointer';



      btnDuo.className = 'px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer';



      badgePrice.innerText = `${soloPrice} €`;



      badgeLabel.innerText = 'total (solo)';



      summaryHotel.innerHTML = `${soloHotel} € <span class="text-xs font-normal">cameră</span>`;



      summaryTotal.innerText = `${soloPrice} €`;



      summarySub.innerText = 'zbor + cameră single';



    });



  </script>





