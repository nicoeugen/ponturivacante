    <!-- CTA Canale Alerte (Desktop) -->
    <div class="hidden md:flex items-center justify-end gap-2 md:w-[220px]">
      <a 
        href="https://whatsapp.com/channel/0029VbDiXkq2v1IzPRElgC0q" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold border border-emerald-200 transition-all hover:scale-105 shadow-xs"
