---



import Layout from '../../layouts/Layout.astro';



import CommunityBanner from '../../components/CommunityBanner.astro';



import AccommodationSelector from '../../components/AccommodationSelector.astro';



import BaggageGuide from '../../components/BaggageGuide.astro';



import deals from '../../../data/deals.json';



import airlines from '../../../data/airlines.json';

import blogArticles from '../../../data/blog_articles.json';



export async function getStaticPaths() {



  return deals.map(deal => ({



    params: { slug: deal.slug },



    props: { deal }



  }));



}



const { deal } = Astro.props;



// Găsim cel mai relevant ghid din blog pentru această destinație

const destLower = (deal.destination || '').toLowerCase();

const countryLower = (deal.country || '').toLowerCase();

const slugLower = deal.slug.toLowerCase();

const catLower = (deal.category || '').toLowerCase();

// Determinare destinații unde Roaming-ul clasic este scump (afara SEE / UK)
const isNonEuRoaming = countryLower.includes('egipt') || 
                       destLower.includes('hurghada') || 
                       destLower.includes('sharm') || 
                       destLower.includes('cairo') || 
                       destLower.includes('londra') || 
                       countryLower.includes('marea britanie') || 
                       countryLower.includes('regatul unit') || 
                       destLower.includes('dubai') || 
                       destLower.includes('abu dhabi') || 
                       countryLower.includes('emirate') || 
                       countryLower.includes('iordania') || 
                       destLower.includes('aqaba') || 
                       destLower.includes('petra') || 
                       countryLower.includes('maroc') || 
                       destLower.includes('marrakech');

let airaloUrl = 'https://www.airalo.com';
let esimBadge = '📱 eSIM Călătorie';
let esimText = 'Evită suprataxele de roaming din afara UE. Activează un eSIM digital instant de pe Airalo de la 4.50$.';

if (countryLower.includes('egipt') || destLower.includes('hurghada') || destLower.includes('sharm') || destLower.includes('cairo')) {
  airaloUrl = 'https://www.airalo.com/egypt-esim';
  esimBadge = '📱 eSIM Egipt (Fără Roaming)';
  esimText = 'În Egipt nu ai roaming UE, iar costul netului clasic poate ajunge la 10€/MB! Ia un eSIM local de la 5$ pentru 4G/5G instant.';
} else if (destLower.includes('londra') || countryLower.includes('marea britanie') || countryLower.includes('regatul unit')) {
  airaloUrl = 'https://www.airalo.com/united-kingdom-esim';
  esimBadge = '📱 eSIM Marea Britanie (UK)';
  esimText = 'După Brexit, multe rețele românești taxează internetul în UK. Activează un eSIM Airalo de la 4.50$ pentru net nelimitat în Londra.';
} else if (destLower.includes('dubai') || destLower.includes('abu dhabi') || countryLower.includes('emirate')) {
  airaloUrl = 'https://www.airalo.com/united-arab-emirates-esim';
  esimBadge = '📱 eSIM Emirate (Dubai & Abu Dhabi)';
  esimText = 'Evită tarifele mari de roaming în Emirate. Activează un pachet de date eSIM de la 5$ direct pe telefon înainte de zbor.';
} else if (countryLower.includes('iordania') || destLower.includes('aqaba') || destLower.includes('petra')) {
  airaloUrl = 'https://www.airalo.com/jordan-esim';
  esimBadge = '📱 eSIM Iordania';
  esimText = 'Net instant în Amman, Petra și Aqaba fără cartelă fizică și fără tarife mari de roaming pe abonament.';
} else if (countryLower.includes('maroc') || destLower.includes('marrakech')) {
  airaloUrl = 'https://www.airalo.com/morocco-esim';
  esimBadge = '📱 eSIM Maroc';
  esimText = 'Conectivitate 4G instant în Marrakech și deșert, fără taxe de roaming pe factura de acasă.';
}

const airaloAffLink = `https://tp.media/r?marker=801687&p=8310&u=${encodeURIComponent(airaloUrl)}`;
const compensairAffLink = `https://tp.media/r?marker=801687&p=2108&u=${encodeURIComponent('https://www.compensair.com')}`;




const relatedArticle = blogArticles.find(a => {

  const tag = (a.tag || '').toLowerCase();

  if (tag === 'egipt') {

    return countryLower.includes('egipt') || destLower.includes('hurghada') || destLower.includes('sharm') || destLower.includes('cairo');

  }

  if (tag === 'schi') {

    return catLower.includes('schi') || slugLower.includes('schi');

  }

  if (tag === 'roma') {

    return destLower.includes('roma') || slugLower.includes('roma');

  }

  if (tag === 'londra') {

    return destLower.includes('londra') || slugLower.includes('londra');

  }

  if (tag === 'cipru') {

    return countryLower.includes('cipru') || destLower.includes('paphos') || destLower.includes('larnaca');

  }

  if (tag === 'maldive' || tag === 'exotice') {

    return catLower.includes('exotic') || destLower.includes('maldive') || destLower.includes('tenerife') || destLower.includes('dubai');

  }

  if (tag === 'croaziere') {

    return catLower.includes('croazier');

  }

  if (tag && (destLower.includes(tag) || countryLower.includes(tag) || slugLower.includes(tag))) {

    return true;

  }

  return false;

}) || blogArticles.find(a => {

  if (catLower.includes('city break')) return a.slug === 'secretul-city-break-sub-100-euro-europa';

  if (catLower.includes('exotic')) return a.slug === 'top-destinatii-exotice-soare-iarna-buget-redus';

  return a.slug === 'cum-sa-gasesti-bilete-avion-ieftine-wizz-ryanair-trucuri';

});





const soloPrice = deal.flight.price + deal.hotel.priceTotal;
const agencyEstimatedPrice = Math.round((deal.priceTotalPerPerson * 1.85) + 35);
const savingsAmount = agencyEstimatedPrice - deal.priceTotalPerPerson;
const savingsPercent = Math.round((savingsAmount / agencyEstimatedPrice) * 100);



const currentAirline = airlines.find(a => a.name.toLowerCase() === deal.flight.airline.toLowerCase()) || {



  name: deal.flight.airline,



  badgeBg: 'bg-slate-100 text-slate-800 border-slate-200',



  baggage: {



    free: deal.flight.baggageInfo || 'Rucsac mic inclus sub scaun',



    dimensions: 'Standard low-cost'



  }



};



---



<Layout 



  title={`${deal.title} — ${deal.priceTotalPerPerson}€`}



  description={deal.description}



  image={deal.image}



>



  <article class="pb-16">



    <!-- Breadcrumb & Top Bar -->



    <div class="bg-slate-100 border-b border-slate-200 py-3">



      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-xs text-slate-500 flex items-center gap-2">



        <a href="/" class="hover:text-rose-600 transition-colors">Acasă</a>



        <span>/</span>



        <a href={`/plecari/${(deal.originCity || "bucuresti").split("/")[0].trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-")}/`} class="hover:text-rose-600 transition-colors">Oferte {deal.originCity}</a>



        <span>/</span>



        <span class="text-slate-800 font-semibold truncate">{deal.destination}</span>



      </div>



    </div>



    <!-- Main Container -->



    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-8">



      <!-- Title & Badges -->



      <div class="mb-6">



        <div class="flex flex-wrap items-center gap-2 mb-3">



          <span class="px-2.5 py-1 rounded-full bg-rose-600 text-white text-xs font-black shadow-sm">



            {deal.badge}



          </span>



          <span class="px-2.5 py-1 rounded-full bg-slate-900 text-white text-xs font-semibold">



            {deal.category}



          </span>



          <span class={`px-2.5 py-1 rounded-full text-xs font-bold border ${currentAirline.badgeBg}`}>



            ✈️ {deal.flight.airline}



          </span>



          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-800 ml-auto shadow-sm">

            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>

            <span>Verificat: {deal.lastVerifiedFormatted ? deal.lastVerifiedFormatted.split(',')[0] : "Recent"}</span>

          </span>



        </div>



        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-3">



          {deal.title} {deal.flag}



        </h1>



        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-600">



          <span class="flex items-center gap-1 font-semibold text-slate-900">



            🛫 Plecare din {deal.originCity} ({deal.originCode})



          </span>



          <span>&bull;</span>



          <span class="flex items-center gap-1">



            📅 {deal.dates} ({deal.nights} nopți)



          </span>



          <span>&bull;</span>



          <span class="flex items-center gap-1 text-emerald-700 font-semibold">



            🧳 {deal.flight.baggageInfo || currentAirline.baggage.dimensions}



          </span>



        </div>



      </div>



      <!-- Featured Image -->



      <div class="rounded-3xl overflow-hidden mb-8 shadow-xl max-h-[460px] relative">



        <img 



          src={deal.image} 



          alt={deal.destination} 



          class="w-full h-full object-cover"



        />



        <div class="absolute bottom-4 right-4 bg-slate-900/90 backdrop-blur text-white px-4 py-2 rounded-2xl shadow-lg flex items-center gap-3">



          <span class="text-xs text-slate-300">Total vacanță:</span>



          <span id="badge-total-price" class="text-2xl font-black text-amber-400">{deal.priceTotalPerPerson} €</span>



          <span id="badge-total-label" class="text-xs text-slate-300">/ persoană</span>



        </div>



      </div>



      <!-- Interactive Traveler Toggle: Duo vs Solo -->

      <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">

        <div>

          <span class="font-bold text-sm text-slate-800">Câți călători sunteți?</span>

          <p class="text-xs text-slate-500">Prețul camerei se împarte la 2 când călătoriți în cuplu sau cu un prieten.</p>

        </div>

        <div class="grid grid-cols-2 sm:inline-flex rounded-xl bg-slate-100 p-1 border border-slate-200 text-xs font-bold w-full sm:w-auto">

          <button 

            id="toggle-duo"

            class="px-2.5 sm:px-4 py-2 rounded-lg bg-white text-slate-900 shadow-sm transition-all cursor-pointer text-center truncate"

          >

            👥 În 2 ({deal.priceTotalPerPerson} €/p)

          </button>

          <button 

            id="toggle-solo"

            class="px-2.5 sm:px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all cursor-pointer text-center truncate"

          >

            👤 Singur ({soloPrice} €)

          </button>

        </div>

      </div>



      <!-- Quick Summary Box -->



      <div class="bg-gradient-to-r from-rose-50 via-amber-50 to-orange-50 rounded-3xl p-6 border border-rose-200/60 mb-10">



        <h2 class="text-lg font-black text-slate-900 mb-3 flex items-center gap-2">



          <span>💡 Cum funcționează această ofertă DIY?</span>



        </h2>



        <p class="text-sm text-slate-700 leading-relaxed mb-4">



          {deal.description}



        </p>



        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">



          <div class="bg-white rounded-xl p-3 border border-slate-200/80 shadow-sm">



            <div class="text-xs text-slate-500 mb-0.5">{deal.transportType === 'car' ? '1. Transport' : '1. Bilet Avion Dus-Întors'}</div>



            <div class="text-lg font-black text-slate-900">{deal.flight.price === 0 ? 'Transport Propriu' : `${deal.flight.price} €`} {deal.flight.price > 0 && <span class="text-xs font-normal text-slate-500">/pers</span>}</div>



            <div class="text-[11px] text-slate-500 font-semibold">{deal.transportType === 'car' ? 'Mașină personală / Fără avion' : deal.flight.airline}</div>



          </div>



          <div class="bg-white rounded-xl p-3 border border-slate-200/80 shadow-sm">



            <div class="text-xs text-slate-500 mb-0.5">2. Cazare ({deal.nights} nopți)</div>



            <div id="summary-hotel-price" class="text-lg font-black text-slate-900">{deal.hotel.pricePerPerson} € <span class="text-xs font-normal">/pers</span></div>



            <div class="text-[11px] text-slate-500">Notă {deal.hotel.rating} ⭐</div>



          </div>



          <div class="bg-rose-600 text-white rounded-xl p-3 shadow-md">



            <div class="text-xs text-rose-100 mb-0.5">Total Vacanță</div>



            <div id="summary-total-price" class="text-xl font-black">{deal.priceTotalPerPerson} €</div>



            <div id="summary-total-sub" class="text-[11px] text-rose-100">{deal.transportType === 'car' ? 'cazare de top / pers' : 'zbor + cazare / pers'}</div>



          </div>



        </div>



      </div>



                  <!-- Comparație Vizuală Preț DIY vs Agenție & Distribuire Prieteni -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        <!-- Card 1: Comparație Preț DIY vs Agenție -->
        <div class="md:col-span-2 bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-5 sm:p-6 shadow-xl border border-slate-800 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
          
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                💰 Economie Reală (Fără Agenții)
              </span>
              <span class="text-xs text-slate-400 font-medium">Preț direct la sursă</span>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-4">
              <!-- Agenție Tradițională -->
              <div class="bg-slate-800/60 rounded-2xl p-3 border border-slate-700/60">
                <div class="text-[11px] text-slate-400 font-medium mb-1">Pachet agenție turism:</div>
                <div class="text-lg sm:text-xl font-bold text-slate-400 line-through">~{agencyEstimatedPrice}&nbsp;€</div>
                <div class="text-[10px] text-slate-500">adaosuri comerciale & taxe</div>
              </div>

              <!-- PonturiVacante DIY -->
              <div class="bg-emerald-950/40 rounded-2xl p-3 border border-emerald-500/30">
                <div class="text-[11px] text-emerald-300 font-medium mb-1">PonturiVacanțe (DIY):</div>
                <div class="text-xl sm:text-2xl font-black text-emerald-400">{deal.priceTotalPerPerson}&nbsp;€</div>
                <div class="text-[10px] text-emerald-300/80">zbor direct + hotel oficial</div>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
            <span class="text-slate-300">Bani economisiți în buzunar:</span>
            <span class="font-extrabold text-emerald-400 bg-emerald-500/15 px-2.5 py-1 rounded-lg border border-emerald-500/30">
              +{savingsAmount}&nbsp;€ / persoană (-{savingsPercent}%)
            </span>
          </div>
        </div>

        <!-- Card 2: Distribuie Oferta pe WhatsApp / Prieteni -->
        <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-3xl p-5 sm:p-6 border border-emerald-200/80 flex flex-col justify-between shadow-sm">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-emerald-800 mb-1 flex items-center gap-1.5">
              <span>👥 Planifici în doi?</span>
            </div>
            <h3 class="text-base font-black text-slate-900 leading-tight mb-2">
              Trimite oferta partenerului sau prietenilor
            </h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              O vacanță frumoasă se decide în doi. Trimite linkul direct pe WhatsApp cu un singur tap.
            </p>
          </div>

          <div class="space-y-2">
            <a 
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Uite ce pont de vacanță am găsit pe PonturiVacanțe: ${deal.title} la doar ${deal.priceTotalPerPerson} €/pers (zbor dus-întors + cazare ${deal.nights} nopți)! Vezi aici: https://ponturivacante.ro/oferta/${deal.slug}/`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs shadow-md transition-all hover:scale-[1.02] active:scale-95"
            >
              <span>📲 Trimite pe WhatsApp</span>
            </a>

            <button 
              type="button"
              id="btn-copy-offer-link"
              data-url={`https://ponturivacante.ro/oferta/${deal.slug}/`}
              class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs border border-slate-200 transition-colors cursor-pointer"
            >
              <span id="copy-icon">🔗</span>
              <span id="copy-text">Copiază Linkul Ofertei</span>
            </button>
          </div>
        </div>
      </div>

<div id="optiuni-rezervare" class="scroll-mt-20"></div>

      <!-- PASUL 1: Detalii Zbor sau Terestru -->



      {deal.transportType === 'car' && (



        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-300 shadow-md mb-10">



          <div class="flex items-center justify-between mb-4">



            <div class="flex items-center gap-3">



              <span class="w-9 h-9 rounded-full bg-emerald-600 text-white font-black flex items-center justify-center text-sm shadow">



                1



              </span>



              <div>



                <h3 class="text-lg sm:text-xl font-bold text-slate-900">



                  Transport Terestru / Cu Mașina Proprie



                </h3>



                <p class="text-xs text-slate-500">{deal.flight.airline}</p>



              </div>



            </div>



            <span class="px-3 py-1 rounded-xl text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-200">



              🚗 Fără bilet avion



            </span>



          </div>



          <div class="bg-emerald-50/60 rounded-2xl p-4 text-sm text-slate-700 mb-4 space-y-2 border border-emerald-100">



            <div><strong>Rută & Durată:</strong> {deal.flight.route}</div>



            <div><strong>Perioadă recomandată:</strong> {deal.dates}</div>



            <div><strong>Bagaj & Echipamente Schi:</strong> {deal.flight.baggageInfo}</div>



          </div>



          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">



            <a 



              href={deal.flight.link}



              target="_blank"



              rel="noopener noreferrer"



              class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm transition-all shadow-md hover:shadow-emerald-600/30"



            >



              <span>🗺️ Deschide Traseul & Navigația pe Google Maps</span>



              <span>&rarr;</span>



            </a>



          </div>



          <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500">



            <span class="flex items-center gap-1.5 font-medium text-emerald-700">



              <span class="font-bold">✓</span> Fără taxe suplimentare pentru echipamentul de schi (schiuri, bețe, clăpari în portbagaj)



            </span>



            <span class="text-slate-500">Vinietă online obligatorie la trecerea graniței</span>



          </div>



        </div>



      )}



      {deal.transportType !== 'car' && (



<div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-slate-200 shadow-md mb-10">



        <div class="flex items-center justify-between mb-4">



          <div class="flex items-center gap-3">



            <span class="w-9 h-9 rounded-full bg-rose-600 text-white font-black flex items-center justify-center text-sm shadow">



              1



            </span>



            <div>



              <h3 class="text-lg sm:text-xl font-bold text-slate-900">



                Rezervă Zborul ({deal.flight.price} € dus-întors / pers)



              </h3>



              <p class="text-xs text-slate-500">Operat de {deal.flight.airline}</p>



            </div>



          </div>



          <span class={`px-3 py-1 rounded-xl text-xs font-black border ${currentAirline.badgeBg}`}>



            {deal.flight.airline}



          </span>



        </div>



        <div class="bg-slate-50 rounded-2xl p-4 text-sm text-slate-700 mb-4 space-y-2 border border-slate-100">



          <div class="flex items-center justify-between">



            <span><strong>Rută:</strong> {deal.originCity} ({deal.originCode}) &rarr; {deal.destination} &rarr; {deal.originCity}</span>



            {deal.flight.isConnecting ? (



              <span class="text-xs font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded">Zbor cu Escală</span>



            ) : (



              <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Zbor Direct</span>



            )}



          </div>



          <div><strong>Date:</strong> {deal.dates}</div>



          <div><strong>Bagaj gratuit:</strong> {deal.flight.baggageInfo || currentAirline.baggage.free}</div>



        </div>



        



        {deal.alternativeAirlines && deal.alternativeAirlines.length > 0 && (



          <div class="mb-5 bg-amber-50/70 border border-amber-200 rounded-2xl p-3.5 text-xs text-slate-700">



            <div class="font-bold text-amber-950 mb-1.5 flex items-center gap-1.5">



              <span>✈️</span> Opțiuni alternative de zbor pe această rută:



            </div>



            <div class="space-y-1">



              {deal.alternativeAirlines.map(alt => (



                <div class="flex items-center justify-between">



                  <span>&bull; {alt.name} ({alt.route})</span>



                  <span class="font-extrabold text-slate-900">{alt.price} € dus-întors</span>



                </div>



              ))}



            </div>



          </div>



        )}



        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">

          <a 

            href={`/go/flight/?url=${encodeURIComponent(deal.flight.link)}&deal=${deal.id}&airline=${deal.flight.airline.toLowerCase()}`}

            target="_blank"

            rel="noopener noreferrer"

            class="flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-sm transition-all shadow-md hover:shadow-rose-600/30 text-center"

          >

            <span>✈️ {deal.flight.isConnecting ? `Rezervă Zbor (${deal.flight.airline} · ${deal.flight.price} € / pers)` : `Site Oficial ${deal.flight.airline} (${deal.flight.price} € / pers)`}</span>

            <span>&rarr;</span>

          </a>



          {deal.flight.skyscannerLink && (

            <a 

              href={`/go/flight/?url=${encodeURIComponent(deal.flight.skyscannerLink)}&deal=${deal.id}&provider=skyscanner`}

              target="_blank"

              rel="noopener noreferrer"

              class="flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-sky-600 hover:bg-sky-700 text-white font-extrabold text-sm transition-all shadow-md hover:shadow-sky-600/30 text-center"

            >

              <span>🔍 Compară & Rezervă pe Skyscanner</span>

              <span>&rarr;</span>

            </a>

          )}

        </div>



